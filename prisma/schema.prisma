// Prisma Schema — Job Search Platform
// Defines core data models for email ingestion

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Supported email providers (extensible for Outlook, Yahoo, etc.)
enum EmailProvider {
  GMAIL
  OUTLOOK
}

/// Connection health status
enum ConnectionStatus {
  ACTIVE
  REVOKED
  EXPIRED
  ERROR
}

/// Stores OAuth credentials linking a user to an email provider.
/// Tokens are encrypted at the application level before storage.
model UserEmailConnection {
  id                    String           @id @default(uuid()) @db.Uuid
  userId                String           @map("user_id")
  provider              EmailProvider
  emailAddress          String           @map("email_address")
  accessTokenEncrypted  String           @map("access_token_encrypted") @db.Text
  refreshTokenEncrypted String           @map("refresh_token_encrypted") @db.Text
  tokenExpiry           DateTime         @map("token_expiry")
  scopes                String[]
  status                ConnectionStatus @default(ACTIVE)
  lastSyncAt            DateTime?        @map("last_sync_at")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  // Relations
  emails EmailMessage[]
  syncState GmailSyncState?

  // Indexes
  @@unique([userId, provider, emailAddress], name: "unique_user_provider_email")
  @@index([userId])
  @@index([provider])
  @@index([status])
  @@map("user_email_connections")
}

/// Normalized email message storage.
/// Ingested from Gmail (or other providers) and stored provider-agnostically.
model EmailMessage {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id")
  connectionId      String   @map("connection_id") @db.Uuid
  applicationId     String?  @map("application_id") @db.Uuid
  recruiterId      String?  @map("recruiter_id") @db.Uuid
  providerMessageId String   @map("provider_message_id")
  threadId          String?  @map("thread_id")
  sender            String
  recipients        Json     // { to: string[], cc: string[], bcc: string[] }
  subject           String   @default("")
  bodyText          String?  @map("body_text") @db.Text
  bodyHtml          String?  @map("body_html") @db.Text
  labels            String[]
  hasAttachments    Boolean  @default(false) @map("has_attachments")
  receivedAt        DateTime @map("received_at")
  createdAt         DateTime @default(now()) @map("created_at")

  // Relations
  connection UserEmailConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  application JobApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  recruiter Recruiter? @relation(fields: [recruiterId], references: [id], onDelete: SetNull)

  // Indexes
  @@unique([userId, providerMessageId], name: "unique_user_message")
  @@index([userId])
  @@index([connectionId])
  @@index([applicationId])
  @@index([recruiterId])
  @@index([threadId])
  @@index([receivedAt])
  @@map("email_messages")
}

/// Tracks the synchronization cursor (historyId) for incremental Gmail sync.
model GmailSyncState {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id")
  connectionId String   @unique @map("connection_id") @db.Uuid
  historyId    String   @map("history_id")
  lastSyncedAt DateTime @map("last_synced_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  connection UserEmailConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  
}

/// Types of background jobs
enum JobType {
  GMAIL_INITIAL_SYNC
  GMAIL_INCREMENTAL_SYNC
}

/// Status of a background job
enum JobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

/// Queue table for asynchronous background jobs
model SyncJob {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id")
  type        JobType
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  nextRunAt   DateTime  @default(now()) @map("next_run_at")
  error       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, nextRunAt])
  @@map("sync_jobs")
}

model JobApplication {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id")
  companyId        String?  @map("company_id") @db.Uuid
  recruiterId      String?  @map("recruiter_id") @db.Uuid
  companyName      String   @map("company_name")
  companyDomain    String   @map("company_domain")
  roleTitle        String   @map("role_title")
  roleDepartment   String   @map("role_department")
  status           String
  appliedDate      DateTime @map("applied_date")
  recruiterName    String   @map("recruiter_name")
  recruiterEmail   String   @map("recruiter_email")
  sourceEmailId    String   @map("source_email_id")
  location         String
  employmentType   String   @map("employment_type")
  currentStage     String   @map("current_stage")
  interviewRounds  Int      @default(0) @map("interview_rounds")
  deadlines        String[]
  candidateEmail   String?  @map("candidate_email")
  atsApplicationId String?  @map("ats_application_id")
  threadIds        String[] @map("thread_ids")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  timeline         ApplicationTimeline[]
  statusHistory    ApplicationStatusHistory[]
  emails           EmailMessage[]
  company          Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  recruiter        Recruiter? @relation(fields: [recruiterId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([companyId])
  @@index([recruiterId])
  @@index([status])
  @@map("job_applications")
}

model ApplicationStatusHistory {
  id               String   @id @default(uuid()) @db.Uuid
  applicationId    String   @map("application_id") @db.Uuid
  previousStatus   String?  @map("previous_status")
  status           String
  source           String
  sourceEmailId    String?  @map("source_email_id")
  changedByUserId  String?  @map("changed_by_user_id")
  timestamp        DateTime
  metadata         Json?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  application      JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([applicationId, timestamp])
  @@map("application_status_history")
}

model Company {
  id           String      @id @default(uuid()) @db.Uuid
  name         String
  domain       String      @unique
  careersUrl    String?     @map("careers_url")
  website      String?
  logoUrl      String?     @map("logo_url")
  industry     String?
  headquarters String?
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  recruiters Recruiter[]
  aliases    CompanyAlias[]
  applications JobApplication[]

  @@index([name])
  @@map("companies")
}

model CompanyAlias {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  value           String
  normalizedValue String   @unique @map("normalized_value")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_aliases")
}

model Recruiter {
  id         String          @id @default(uuid()) @db.Uuid
  companyId  String          @map("company_id") @db.Uuid
  name       String
  email      String
  title      String
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications JobApplication[]
  emails     EmailMessage[]

  @@unique([companyId, email], name: "unique_company_recruiter_email")
  @@index([companyId])
  @@index([email])
  @@map("recruiters")
}

enum ApplicationTimelineEventType {
  APPLICATION_SUBMITTED
  APPLICATION_CONFIRMED
  RECRUITER_CONTACT
  ASSESSMENT
  ASSESSMENT_COMPLETED
  PHONE_SCREEN
  INTERVIEW
  FINAL_INTERVIEW
  OFFER
  REJECTION
  WITHDRAWN
}

model ApplicationTimeline {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  eventType     ApplicationTimelineEventType @map("event_type")
  timestamp     DateTime
  sourceEmailId  String?  @map("source_email_id")
  metadata      Json?
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([applicationId, timestamp])
  @@map("application_timeline")
}
