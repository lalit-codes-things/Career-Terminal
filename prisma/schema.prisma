// ─────────────────────────────────────────────────────────────────────────────
// COMPANY INTELLIGENCE FOUNDATION
// ─────────────────────────────────────────────────────────────────────────────
//
// Foundational, provider-agnostic company intelligence schema. These tables
// hold global canonical company data sourced from external providers (SEC,
// Companies House, India MCA) and are intentionally decoupled from the
// user-scoped `companies` table used by job-application tracking.
//
// Design notes:
//  - Identifiers use a string `type` column so new identifier types can be
//    added without a migration (see identifiers/identifier-types.ts).
//  - Every fact-bearing row carries valid_from/valid_to temporal validity.
//  - provenance is captured at both the import-run level (CompanyImportRun)
//    and the per-record level (CompanyProviderRecord).
//  - enrichment_status/version/last_enriched_at are hooks for FUTURE
//    enrichment prompts — analytics/scoring are NOT part of this foundation.

enum CompanyLifecycleStatus {
  ACTIVE
  INACTIVE
  DISSOLVED
  DORMANT
  LIQUIDATED
  UNKNOWN
}

enum CompanyImportType {
  FULL
  INCREMENTAL
  SCHEDULED
  MANUAL
}

enum CompanyImportRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
  SKIPPED
}

model CanonicalCompany {
  id               String                @id @default(uuid()) @db.Uuid
  name             String
  legalName        String?               @map("legal_name")
  normalizedName   String                @map("normalized_name")
  domain           String?
  countryCode      String?               @map("country_code")
  jurisdictionCode String?               @map("jurisdiction_code")
  status           CompanyLifecycleStatus @default(UNKNOWN)
  foundedDate      DateTime?             @map("founded_date") @db.Date
  incorporatedDate DateTime?             @map("incorporated_date") @db.Date
  description      String?               @db.Text
  validFrom        DateTime?             @map("valid_from") @db.Timestamptz
  validTo          DateTime?             @map("valid_to") @db.Timestamptz
  enrichmentStatus String                @default("none") @map("enrichment_status")
  enrichmentVersion Int?                 @map("enrichment_version")
  lastEnrichedAt   DateTime?             @map("last_enriched_at") @db.Timestamptz
  companyId        String?               @unique @map("company_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  company          Company?                     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  aliases          CanonicalCompanyAlias[]
  identifiers      CompanyIdentifier[]
  websites         CompanyWebsite[]
  addresses        CompanyAddress[]
  industryClassifications CompanyIndustryClassification[]
  exchangeListings CompanyExchangeListing[]
  providerRecords  CompanyProviderRecord[]

  @@index([normalizedName])
  @@index([domain])
  @@index([countryCode])
  @@index([jurisdictionCode])
  @@index([status])
  @@index([validFrom, validTo])
  @@map("canonical_companies")
}

model CanonicalCompanyAlias {
  id                 String    @id @default(uuid()) @db.Uuid
  canonicalCompanyId String    @map("canonical_company_id") @db.Uuid
  value              String
  normalizedValue    String    @map("normalized_value")
  aliasType          String    @default("trade") @map("alias_type")
  validFrom          DateTime? @map("valid_from") @db.Timestamptz
  validTo            DateTime? @map("valid_to") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  canonicalCompany CanonicalCompany @relation(fields: [canonicalCompanyId], references: [id], onDelete: Cascade)

  @@unique([canonicalCompanyId, normalizedValue], name: "canonical_company_alias_company_value_unique")
  @@index([normalizedValue])
  @@map("canonical_company_aliases")
}

model CompanyIdentifier {
  id                 String    @id @default(uuid()) @db.Uuid
  canonicalCompanyId String    @map("canonical_company_id") @db.Uuid
  type               String
  value              String
  normalizedValue    String    @map("normalized_value")
  jurisdictionCode   String?   @map("jurisdiction_code")
  registrar          String?
  validFrom          DateTime? @map("valid_from") @db.Timestamptz
  validTo            DateTime? @map("valid_to") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  canonicalCompany CanonicalCompany @relation(fields: [canonicalCompanyId], references: [id], onDelete: Cascade)

  @@unique([type, normalizedValue, jurisdictionCode], name: "company_identifier_unique")
  @@index([normalizedValue])
  @@index([type])
  @@map("company_identifiers")
}

model CompanyWebsite {
  id                 String    @id @default(uuid()) @db.Uuid
  canonicalCompanyId String    @map("canonical_company_id") @db.Uuid
  url                String
