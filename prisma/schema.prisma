  sourceType        String              @map("source_type")
  sourceId          String              @map("source_id")
  provider          String
  model             String
  status            AiExtractionStatus  @default(PENDING)
  inputTokens       Int                 @default(0) @map("input_tokens")
  outputTokens      Int                 @default(0) @map("output_tokens")
  estimatedCostUsd  Float               @default(0) @map("estimated_cost_usd")
  latencyMs         Int                 @default(0) @map("latency_ms")
  overallConfidence Float               @default(0) @map("overall_confidence")
  requiresReview    Boolean             @default(false) @map("requires_review")
