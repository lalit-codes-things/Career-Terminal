generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum EmailProvider {
  GMAIL
  OUTLOOK
}

enum ConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

enum ApplicationStatus {
  SAVED
  APPLIED
  SCREENING
  ASSESSMENT
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum ApplicationSourceProvider {
  GMAIL
  MANUAL
  OUTLOOK
  CSV
  API
}

enum JobType {
  GMAIL_INITIAL_SYNC
  GMAIL_INCREMENTAL_SYNC
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum ApplicationTimelineEventType {
  APPLICATION_SUBMITTED
  APPLICATION_CONFIRMED
  RECRUITER_CONTACT
  ASSESSMENT
  ASSESSMENT_COMPLETED
  PHONE_SCREEN
  INTERVIEW
  FINAL_INTERVIEW
  OFFER
  REJECTION
  WITHDRAWN
}

enum CellStatus {
  ACTIVE
  DRAINING
  READ_ONLY
  MIGRATING
  DISABLED
}

enum CellLifecycleState {
  PROVISIONING
  ACTIVE
  DRAINING
  MIGRATING
  DISABLED
}

enum CellRoutingState {
  ROUTABLE
  WRITE_BLOCKED
  READ_ONLY
  UNROUTABLE
}

enum RecruiterVerificationStatus {
  VERIFIED
  PENDING
  UNVERIFIED
  REJECTED
}

enum RecruiterEventType {
  RECRUITER_CREATED
  RECRUITER_UPDATED
  RECRUITER_MERGED
  EMPLOYMENT_ADDED
  EMPLOYMENT_UPDATED
  COMMUNICATION_IMPORTED
  FACT_RECORDED
  FACT_UPDATED
  FACT_SUPERSEDED
  EVIDENCE_ATTACHED
}

enum AiExtractionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  REQUIRES_REVIEW
}

// ─────────────────────────────────────────────────────────────────────────────
// IDENTITY / TENANCY
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String?   @unique
  name                String?
  cellId              String?   @map("cell_id")
  region              String    @default("us-east-1")
  dataResidencyRegion String    @default("us-east-1") @map("data_residency_region")
  shardKey            Int       @default(0) @map("shard_key")
  tenantId            String?   @map("tenant_id") @db.Uuid
  consentVersion      String    @default("v1") @map("consent_version")
  consentGrantedAt    DateTime  @default(now()) @map("consent_granted_at") @db.Timestamptz
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz
  deletionStatus      String    @default("active") @map("deletion_status")
  deletionRequestedAt DateTime? @map("deletion_requested_at") @db.Timestamptz
  deletionCompletedAt DateTime? @map("deletion_completed_at") @db.Timestamptz
  legalHoldReason     String?   @map("legal_hold_reason") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  connections           UserEmailConnection[]
  syncStates            GmailSyncState[]
  candidateProfile      CandidateProfile?
  idMappings            UserIdMapping[]
  syncJobs              SyncJob[]
  jobApplications       JobApplication[]
  userResumes           UserResume[]
  resumes               Resume[]
  checkpoint            GmailCheckpoint?
  syncBatches           SyncBatch[]
  snapshots             Snapshot[]
  factObservations      FactObservation[]
  extractionRuns        ExtractionRun[]
  factProvenance        FactProvenance[]
  outcomeEvents         OutcomeEvent[]
  actionEvents          ActionEvent[]
  predictions           Prediction[]
  predictionFeedback    PredictionFeedback[]
  recommendations       Recommendation[]
  correctedFacts        FactObservation[]                @relation("FactCorrectedBy")
  reviewedFacts         FactObservation[]                @relation("FactReviewedBy")
  homeCell              Cell?                            @relation(fields: [cellId], references: [id], onDelete: SetNull)
  canonicalIntelligence CanonicalCandidateIntelligence[]
  events                Event[]
  opportunityObservations OpportunityObservation[]

  @@index([region])
  @@index([deletionStatus])
  @@index([shardKey])
  @@index([tenantId])
  @@index([dataResidencyRegion])
  @@index([cellId])
  @@map("users")
}

model Cell {
  id                String             @id
  region            String
  residencyPolicyId String?            @map("residency_policy_id")
  status            CellStatus         @default(ACTIVE)
  lifecycleState    CellLifecycleState @default(ACTIVE) @map("lifecycle_state")
  routingState      CellRoutingState   @default(ROUTABLE) @map("routing_state")
  capacityState     String?            @map("capacity_state")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  users User[]

  @@index([region])
  @@index([status])
  @@index([routingState])
  @@map("cells")
}

model CandidateProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  fullName    String?  @map("full_name")
  phone       String?
  location    String?
  timezone    String?
  preferences Json     @default("{}")
  careerGoals Json?    @map("career_goals")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("candidate_profiles")
}

model UserIdMapping {
  id         String   @id @default(uuid()) @db.Uuid
  externalId String   @unique @map("external_id")
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_id_mapping")
}

// ─────────────────────────────────────────────────────────────────────────────
// EMAIL CONNECTIONS / SYNC STATE
// ─────────────────────────────────────────────────────────────────────────────

model UserEmailConnection {
  id                    String           @id @default(uuid()) @db.Uuid
  userId                String           @map("user_id") @db.Uuid
  legacyUserId          String           @map("legacy_user_id")
  provider              EmailProvider
  emailAddress          String           @map("email_address")
  accessTokenEncrypted  String           @map("access_token_encrypted")
  refreshTokenEncrypted String           @map("refresh_token_encrypted")
  tokenExpiry           DateTime         @map("token_expiry") @db.Timestamptz
  scopes                String[]
  status                ConnectionStatus @default(ACTIVE)
  expiresAt             DateTime         @default(now()) @map("expires_at") @db.Timestamptz
  lastSyncAt            DateTime?        @map("last_sync_at") @db.Timestamptz
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncStates            GmailSyncState[]

  @@unique([legacyUserId, provider, emailAddress], name: "unique_user_provider_email")
  @@index([userId])
  @@index([provider])
  @@index([status])
  @@map("user_email_connections")
}

model GmailSyncState {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @unique @map("user_id") @db.Uuid
  legacyUserId String              @unique @map("legacy_user_id")
  connectionId String              @map("connection_id") @db.Uuid
  historyId    String              @map("history_id")
  lastSyncedAt DateTime            @default(now()) @map("last_synced_at") @db.Timestamptz
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection   UserEmailConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("gmail_sync_states")
}

model GmailCheckpoint {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  currentHistoryId String?  @map("current_history_id")
  pendingHistoryId String?  @map("pending_history_id")
  pageToken        String?  @map("page_token")
  syncMode         String   @default("INCREMENTAL_SYNC") @map("sync_mode")
  version          Int      @default(1)
  status           String   @default("idle")
  lastSyncAt       DateTime @default(now()) @map("last_sync_at") @db.Timestamptz
  lastError        String?  @map("last_error") @db.Text
  leaseOwner       String?  @map("lease_owner")
  leaseExpiresAt   DateTime? @map("lease_expires_at") @db.Timestamptz
  workerId         String?  @map("worker_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("gmail_checkpoints")
}

model SyncOperation {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  legacyUserId   String       @map("legacy_user_id")
  connectionId   String       @map("connection_id") @db.Uuid
  syncMode       String       @map("sync_mode")
  correlationId  String?      @map("correlation_id")
  status         String       @default("running")
  attempt        Int          @default(1)
  startedAt      DateTime     @default(now()) @map("started_at") @db.Timestamptz
  completedAt    DateTime?    @map("completed_at") @db.Timestamptz
  error          String?      @db.Text
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId, status])
  @@index([connectionId, status])
  @@index([correlationId])
  @@map("sync_operations")
}

model SyncJob {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  legacyUserId String    @map("legacy_user_id")
  type         JobType
  status       JobStatus @default(PENDING)
  attempts     Int       @default(0)
  startedAt    DateTime? @map("started_at") @db.Timestamptz
  completedAt  DateTime? @map("completed_at") @db.Timestamptz
  nextRunAt    DateTime  @default(now()) @map("next_run_at") @db.Timestamptz
  error        String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, nextRunAt])
  @@index([userId])
  @@map("sync_jobs")
}

model SyncBatch {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  historyId      String          @map("history_id")
  pageToken      String?         @map("page_token")
  correlationId  String?         @map("correlation_id")
  status         String          @default("pending")
  totalEmails    Int?            @map("total_emails")
  processedCount Int             @default(0) @map("processed_count")
  failedCount    Int             @default(0) @map("failed_count")
  startedAt      DateTime        @default(now()) @map("started_at") @db.Timestamptz
  completedAt    DateTime?       @map("completed_at") @db.Timestamptz
  error          String?         @db.Text
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailJobs      BatchEmailJob[]

  @@index([userId])
  @@index([status])
  @@map("sync_batches")
}

model BatchEmailJob {
  id                String    @id @default(uuid()) @db.Uuid
  batchId           String    @map("batch_id") @db.Uuid
  emailId           String    @map("email_id") @db.Uuid
  providerMessageId String    @map("provider_message_id")
  status            String    @default("pending")
  attempts          Int       @default(0)
  lastError         String?   @map("last_error") @db.Text
  processedAt       DateTime? @map("processed_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  batch             SyncBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([status])
  @@map("batch_email_jobs")
}

model DeadLetterEmail {
  id                String   @id @default(uuid()) @db.Uuid
  emailId           String   @map("email_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  providerMessageId String   @map("provider_message_id")
  error             String   @db.Text
  failedAt          DateTime @default(now()) @map("failed_at") @db.Timestamptz
  resolved          Boolean  @default(false)
  attempts          Int      @default(0)

  @@index([userId])
  @@index([emailId])
  @@index([resolved])
  @@map("dead_letter_emails")
}

model GmailSyncQueue {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  legacyUserId String    @map("legacy_user_id")
  connectionId String    @map("connection_id") @db.Uuid
  syncMode     String    @map("sync_mode")
  priority     Int       @default(0)
  attempts     Int       @default(0)
  maxAttempts  Int       @default(5) @map("max_attempts")
  nextRunAt    DateTime  @default(now()) @map("next_run_at") @db.Timestamptz
  lastError    String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([userId, syncMode], name: "unique_user_sync_mode")
  @@index([nextRunAt, priority])
  @@map("gmail_sync_queue")
}

model MalwareScanResult {
  id             String    @id @default(uuid()) @db.Uuid
  userResumeId   String    @map("user_resume_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  scanner        String
  result         String
  threats        Json?
  scanDurationMs Int?      @map("scan_duration_ms")
  scannedAt      DateTime  @default(now()) @map("scanned_at") @db.Timestamptz
  metadata       Json      @default("{}")

  @@index([userResumeId])
  @@index([userId])
  @@map("malware_scan_results")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMPANIES / OPPORTUNITIES / RECRUITERS
// ─────────────────────────────────────────────────────────────────────────────

model Company {
  id            String           @id @default(uuid()) @db.Uuid
  name          String
  domain        String           @unique
  careersUrl    String?          @map("careers_url")
  website       String?
  logoUrl       String?          @map("logo_url")
  industry      String?
  headquarters  String?
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  aliases       CompanyAlias[]
  recruiters    Recruiter[]
  opportunities Opportunity[]
  applications  JobApplication[]
  companySignals CompanySignal[]
  canonicalCompany CanonicalCompany?

  @@index([name])
  @@map("companies")
}

model CompanyAlias {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  value           String
  normalizedValue String   @unique @map("normalized_value")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_aliases")
}

model Recruiter {
  id           String           @id @default(uuid()) @db.Uuid
  companyId    String           @map("company_id") @db.Uuid
  name         String
  email        String
  title        String
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  emails       EmailMessage[]
  applications JobApplication[]

  @@unique([companyId, email], name: "unique_company_recruiter_email")
  @@index([companyId])
  @@index([email])
  @@map("recruiters")
}

model RecruiterIdentity {
  id                    String                    @id @default(uuid()) @db.Uuid
  recruiterId           String                    @map("recruiter_id") @db.Uuid
  canonicalRecruiterId  String?                   @map("canonical_recruiter_id") @db.Uuid
  identityType          String                    @map("identity_type")
  identityValue         String                    @map("identity_value")
  normalizedValue       String                    @map("normalized_value")
  confidence            Float                     @default(0.5)
  verificationStatus    RecruiterVerificationStatus @default(PENDING) @map("verification_status")
  source                String
  deletedAt             DateTime?                 @map("deleted_at") @db.Timestamptz
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.Timestamptz
  version               Int                      @default(1)

  @@unique([identityType, normalizedValue], name: "recruiter_identity_unique")
  @@index([recruiterId])
  @@index([canonicalRecruiterId])
  @@index([identityType, normalizedValue])
  @@index([verificationStatus])
  @@index([deletedAt])
  @@map("recruiter_identities")
}

model RecruiterAlias {
  id                String                    @id @default(uuid()) @db.Uuid
  recruiterId       String                    @map("recruiter_id") @db.Uuid
  alias             String
  normalizedAlias  String                    @map("normalized_alias")
  confidence        Float                     @default(0.5)
  verificationStatus RecruiterVerificationStatus @default(PENDING) @map("verification_status")
  source            String
  deletedAt         DateTime?                 @map("deleted_at") @db.Timestamptz
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz
  version           Int                      @default(1)

  @@unique([recruiterId, normalizedAlias], name: "recruiter_alias_unique")
  @@index([recruiterId])
  @@index([normalizedAlias])
  @@index([verificationStatus])
  @@index([deletedAt])
  @@map("recruiter_aliases")
}

model RecruiterEmail {
  id                 String                    @id @default(uuid()) @db.Uuid
  recruiterId        String                    @map("recruiter_id") @db.Uuid
  email              String
  normalizedEmail    String                    @map("normalized_email")
  confidence         Float                     @default(0.5)
  verificationStatus RecruiterVerificationStatus @default(PENDING) @map("verification_status")
  source             String
  deletedAt          DateTime?                 @map("deleted_at") @db.Timestamptz
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz
  version            Int                      @default(1)

  @@unique([normalizedEmail], name: "recruiter_email_unique")
  @@index([recruiterId])
  @@index([normalizedEmail])
  @@index([verificationStatus])
  @@map("recruiter_emails")
}

model RecruiterPhone {
  id                 String                    @id @default(uuid()) @db.Uuid
  recruiterId        String                    @map("recruiter_id") @db.Uuid
  phone              String
  normalizedPhone    String                    @map("normalized_phone")
  confidence         Float                     @default(0.5)
  verificationStatus RecruiterVerificationStatus @default(PENDING) @map("verification_status")
  source             String
  deletedAt          DateTime?                 @map("deleted_at") @db.Timestamptz
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz
  version            Int                      @default(1)

  @@unique([normalizedPhone], name: "recruiter_phone_unique")
  @@index([recruiterId])
  @@index([normalizedPhone])
  @@map("recruiter_phones")
}

model RecruiterSocialProfile {
  id                 String                    @id @default(uuid()) @db.Uuid
  recruiterId        String                    @map("recruiter_id") @db.Uuid
  profileType        String                    @map("profile_type")
  profileValue       String                    @map("profile_value")
  normalizedValue    String                    @map("normalized_value")
  confidence         Float                     @default(0.5)
  verificationStatus RecruiterVerificationStatus @default(PENDING) @map("verification_status")
  source             String
  deletedAt          DateTime?                 @map("deleted_at") @db.Timestamptz
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz
  version            Int                      @default(1)

  @@unique([profileType, normalizedValue], name: "recruiter_social_profile_unique")
  @@index([recruiterId])
  @@index([profileType, normalizedValue])
  @@map("recruiter_social_profiles")
}

model RecruiterEmployment {
  id                 String                    @id @default(uuid()) @db.Uuid
  recruiterId        String                    @map("recruiter_id") @db.Uuid
  organizationId     String?                   @map("organization_id") @db.Uuid
  title              String
  department         String?
  team               String?
  startDate          DateTime?                 @map("start_date") @db.Timestamptz
  endDate            DateTime?                 @map("end_date") @db.Timestamptz
  confidence         Float                     @default(0.5)
  verificationStatus RecruiterVerificationStatus @default(PENDING) @map("verification_status")
  source             String
  deletedAt          DateTime?                 @map("deleted_at") @db.Timestamptz
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz
  version            Int                      @default(1)

  @@index([recruiterId])
  @@index([organizationId])
  @@index([department])
  @@index([team])
  @@index([deletedAt])
  @@map("recruiter_employments")
}

model RecruiterRole {
  id                 String                    @id @default(uuid()) @db.Uuid
  recruiterId        String                    @map("recruiter_id") @db.Uuid
  roleName           String                    @map("role_name")
  confidence         Float                     @default(0.5)
  verificationStatus RecruiterVerificationStatus @default(PENDING) @map("verification_status")
  source             String
  deletedAt          DateTime?                 @map("deleted_at") @db.Timestamptz
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz
  version            Int                      @default(1)

  @@index([recruiterId])
  @@index([roleName])
  @@map("recruiter_roles")
}

model RecruiterDepartment {
  id                 String                    @id @default(uuid()) @db.Uuid
  recruiterId        String                    @map("recruiter_id") @db.Uuid
  departmentName     String                    @map("department_name")
  confidence         Float                     @default(0.5)
  verificationStatus RecruiterVerificationStatus @default(PENDING) @map("verification_status")
  source             String
  deletedAt          DateTime?                 @map("deleted_at") @db.Timestamptz
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz
  version            Int                      @default(1)

  @@index([recruiterId])
  @@index([departmentName])
  @@map("recruiter_departments")
}

model RecruiterTeam {
  id                 String                    @id @default(uuid()) @db.Uuid
  recruiterId        String                    @map("recruiter_id") @db.Uuid
  teamName           String                    @map("team_name")
  confidence         Float                     @default(0.5)
  verificationStatus RecruiterVerificationStatus @default(PENDING) @map("verification_status")
  source             String
  deletedAt          DateTime?                 @map("deleted_at") @db.Timestamptz
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz
  version            Int                      @default(1)

