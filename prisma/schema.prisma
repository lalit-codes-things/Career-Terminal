  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  importRuns CompanyImportRun[]

  @@map("company_providers")
}

model CompanyImportRun {
  id                     String               @id @default(uuid()) @db.Uuid
  providerId             String               @map("provider_id") @db.Uuid
  providerKey            String               @map("provider_key")
  importType             CompanyImportType    @map("import_type")
  status                 CompanyImportRunStatus
  since                  DateTime?            @db.Timestamptz
  startedAt              DateTime             @map("started_at") @db.Timestamptz
  completedAt            DateTime?            @map("completed_at") @db.Timestamptz
  recordsFetched         Int                  @default(0) @map("records_fetched")
  recordsValidated       Int                  @default(0) @map("records_validated")
  recordsFailedValidation Int                 @default(0) @map("records_failed_validation")
  companiesCreated       Int                  @default(0) @map("companies_created")
  companiesUpdated       Int                  @default(0) @map("companies_updated")
  companiesMatched       Int                  @default(0) @map("companies_matched")
  errors                 Int                  @default(0)
  error                  String?              @db.Text
  correlationId          String?              @map("correlation_id")
  metadata               Json                 @default("{}")
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  provider        CompanyProvider       @relation(fields: [providerId], references: [id], onDelete: Restrict)
  providerRecords CompanyProviderRecord[]

  @@index([providerKey, importType])
  @@index([providerId, startedAt])
  @@index([status])
  @@map("company_import_runs")
}

model CompanyProviderRecord {
  id                 String    @id @default(uuid()) @db.Uuid
  importRunId        String    @map("import_run_id") @db.Uuid
