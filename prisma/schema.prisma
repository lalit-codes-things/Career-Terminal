generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum EmailProvider {
  GMAIL
  OUTLOOK
}

enum ConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

enum ApplicationStatus {
  SAVED
  APPLIED
  SCREENING
  ASSESSMENT
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum ApplicationSourceProvider {
  GMAIL
  MANUAL
  OUTLOOK
  CSV
  API
}

enum JobType {
  GMAIL_INITIAL_SYNC
  GMAIL_INCREMENTAL_SYNC
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum ApplicationTimelineEventType {
  APPLICATION_SUBMITTED
  APPLICATION_CONFIRMED
  RECRUITER_CONTACT
  ASSESSMENT
  ASSESSMENT_COMPLETED
  PHONE_SCREEN
  INTERVIEW
  FINAL_INTERVIEW
  OFFER
  REJECTION
  WITHDRAWN
}

enum CellStatus {
  ACTIVE
  DRAINING
  READ_ONLY
  MIGRATING
  DISABLED
}

enum CellLifecycleState {
  PROVISIONING
  ACTIVE
  DRAINING
  MIGRATING
  DISABLED
}

enum CellRoutingState {
  ROUTABLE
  WRITE_BLOCKED
  READ_ONLY
  UNROUTABLE
}

enum DatasetClassification {
  REFERENCE_DATA
  HISTORICAL_DATA
  RUNTIME_INGESTION
  API_ONLY_SOURCE
  DERIVED_DATA
  USER_OUTCOME_DATA
}

enum SourceAccessMethod {
  DOWNLOAD
  API
  PUBLIC_WEB
  MANUAL
  LICENSED_FEED
}

enum DatasetVersionStatus {
  STAGED
  VALIDATED
  IMPORTING
  IMPORTED
  FAILED
  VERIFIED
  SUPERSEDED
}

enum SourceRecordStatus {
  ACTIVE
  SUPERSEDED
  RETRACTED
  INVALIDATED
}

enum ObservationKind {
  OBSERVED_FACT
  INFERENCE
  SIGNAL
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
  UNKNOWN
}

enum CompanyRelationshipType {
  BRAND
  LEGAL_ENTITY
  PARENT
  SUBSIDIARY
  FORMER_NAME
  ACQUIRED_ENTITY
}

enum OpportunityCompanyLinkType {
  HIRING_COMPANY
  EMPLOYER_OF_RECORD
  STAFFING_FIRM
  RECRUITING_AGENCY
}

// ─────────────────────────────────────────────────────────────────────────────
// IDENTITY / TENANCY
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String?   @unique
  name                String?
  cellId              String?   @map("cell_id")
  region              String    @default("us-east-1")
  dataResidencyRegion String    @default("us-east-1") @map("data_residency_region")
  shardKey            Int       @default(0) @map("shard_key")
  tenantId            String?   @map("tenant_id") @db.Uuid
  consentVersion      String    @default("v1") @map("consent_version")
  consentGrantedAt    DateTime  @default(now()) @map("consent_granted_at") @db.Timestamptz
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz
  deletionStatus      String    @default("active") @map("deletion_status")
  deletionRequestedAt DateTime? @map("deletion_requested_at") @db.Timestamptz
  deletionCompletedAt DateTime? @map("deletion_completed_at") @db.Timestamptz
  legalHoldReason     String?   @map("legal_hold_reason") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  connections           UserEmailConnection[]
  syncStates            GmailSyncState[]
  candidateProfile      CandidateProfile?
  idMappings            UserIdMapping[]
  syncJobs              SyncJob[]
  jobApplications       JobApplication[]
  userResumes           UserResume[]
  resumes               Resume[]
  checkpoint            GmailCheckpoint?
  syncBatches           SyncBatch[]
  snapshots             Snapshot[]
  factObservations      FactObservation[]
  extractionRuns        ExtractionRun[]
  factProvenance        FactProvenance[]
  outcomeEvents         OutcomeEvent[]
  actionEvents          ActionEvent[]
  predictions           Prediction[]
  predictionFeedback    PredictionFeedback[]
  recommendations       Recommendation[]
  correctedFacts        FactObservation[]                @relation("FactCorrectedBy")
  reviewedFacts         FactObservation[]                @relation("FactReviewedBy")
  homeCell              Cell?                            @relation(fields: [cellId], references: [id], onDelete: SetNull)
  canonicalIntelligence CanonicalCandidateIntelligence[]
  events                Event[]
  opportunityObservations OpportunityObservation[]

  @@index([region])
  @@index([deletionStatus])
  @@index([shardKey])
  @@index([tenantId])
  @@index([dataResidencyRegion])
  @@index([cellId])
  @@map("users")
}

model Cell {
  id                String             @id
  region            String
  residencyPolicyId String?            @map("residency_policy_id")
  status            CellStatus         @default(ACTIVE)
  lifecycleState    CellLifecycleState @default(ACTIVE) @map("lifecycle_state")
  routingState      CellRoutingState   @default(ROUTABLE) @map("routing_state")
  capacityState     String?            @map("capacity_state")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  users User[]

  @@index([region])
  @@index([status])
  @@index([routingState])
  @@map("cells")
}

model CandidateProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  fullName    String?  @map("full_name")
  phone       String?
  location    String?
  timezone    String?
  preferences Json     @default("{}")
  careerGoals Json?    @map("career_goals")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("candidate_profiles")
}

model UserIdMapping {
  id         String   @id @default(uuid()) @db.Uuid
  externalId String   @unique @map("external_id")
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_id_mapping")
}

// ─────────────────────────────────────────────────────────────────────────────
// EMAIL CONNECTIONS / SYNC STATE
// ─────────────────────────────────────────────────────────────────────────────

model UserEmailConnection {
  id                    String           @id @default(uuid()) @db.Uuid
  userId                String           @map("user_id") @db.Uuid
  legacyUserId          String           @map("legacy_user_id")
  provider              EmailProvider
  emailAddress          String           @map("email_address")
  accessTokenEncrypted  String           @map("access_token_encrypted")
  refreshTokenEncrypted String           @map("refresh_token_encrypted")
  tokenExpiry           DateTime         @map("token_expiry") @db.Timestamptz
  scopes                String[]
  status                ConnectionStatus @default(ACTIVE)
  expiresAt             DateTime         @default(now()) @map("expires_at") @db.Timestamptz
  lastSyncAt            DateTime?        @map("last_sync_at") @db.Timestamptz
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncStates            GmailSyncState[]

  @@unique([legacyUserId, provider, emailAddress], name: "unique_user_provider_email")
  @@index([userId])
  @@index([provider])
  @@index([status])
  @@map("user_email_connections")
}

model GmailSyncState {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @unique @map("user_id") @db.Uuid
  legacyUserId String              @unique @map("legacy_user_id")
  connectionId String              @map("connection_id") @db.Uuid
  historyId    String              @map("history_id")
  lastSyncedAt DateTime            @default(now()) @map("last_synced_at") @db.Timestamptz
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection   UserEmailConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("gmail_sync_states")
}

model GmailCheckpoint {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  currentHistoryId String?  @map("current_history_id")
  pendingHistoryId String?  @map("pending_history_id")
  pageToken        String?  @map("page_token")
  syncMode         String   @default("INCREMENTAL_SYNC") @map("sync_mode")
  version          Int      @default(1)
  status           String   @default("idle")
  lastSyncAt       DateTime @default(now()) @map("last_sync_at") @db.Timestamptz
  lastError        String?  @map("last_error") @db.Text
  leaseOwner       String?  @map("lease_owner")
  leaseExpiresAt   DateTime? @map("lease_expires_at") @db.Timestamptz
  workerId         String?  @map("worker_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("gmail_checkpoints")
}

model SyncOperation {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  legacyUserId   String       @map("legacy_user_id")
  connectionId   String       @map("connection_id") @db.Uuid
  syncMode       String       @map("sync_mode")
  correlationId  String?      @map("correlation_id")
  status         String       @default("running")
  attempt        Int          @default(1)
  startedAt      DateTime     @default(now()) @map("started_at") @db.Timestamptz
  completedAt    DateTime?    @map("completed_at") @db.Timestamptz
  error          String?      @db.Text
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId, status])
  @@index([connectionId, status])
  @@index([correlationId])
  @@map("sync_operations")
}

model SyncJob {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  legacyUserId String    @map("legacy_user_id")
  type         JobType
  status       JobStatus @default(PENDING)
  attempts     Int       @default(0)
  startedAt    DateTime? @map("started_at") @db.Timestamptz
  completedAt  DateTime? @map("completed_at") @db.Timestamptz
  nextRunAt    DateTime  @default(now()) @map("next_run_at") @db.Timestamptz
  error        String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, nextRunAt])
  @@index([userId])
  @@map("sync_jobs")
}

model SyncBatch {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  historyId      String          @map("history_id")
  pageToken      String?         @map("page_token")
  correlationId  String?         @map("correlation_id")
  status         String          @default("pending")
  totalEmails    Int?            @map("total_emails")
  processedCount Int             @default(0) @map("processed_count")
  failedCount    Int             @default(0) @map("failed_count")
  startedAt      DateTime        @default(now()) @map("started_at") @db.Timestamptz
  completedAt    DateTime?       @map("completed_at") @db.Timestamptz
  error          String?         @db.Text
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailJobs      BatchEmailJob[]

  @@index([userId])
  @@index([status])
  @@map("sync_batches")
}

model BatchEmailJob {
  id                String    @id @default(uuid()) @db.Uuid
  batchId           String    @map("batch_id") @db.Uuid
  emailId           String    @map("email_id") @db.Uuid
  providerMessageId String    @map("provider_message_id")
  status            String    @default("pending")
  attempts          Int       @default(0)
  lastError         String?   @map("last_error") @db.Text
  processedAt       DateTime? @map("processed_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  batch             SyncBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([status])
  @@map("batch_email_jobs")
}

model DeadLetterEmail {
  id                String   @id @default(uuid()) @db.Uuid
  emailId           String   @map("email_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  providerMessageId String   @map("provider_message_id")
  error             String   @db.Text
  failedAt          DateTime @default(now()) @map("failed_at") @db.Timestamptz
  resolved          Boolean  @default(false)
  attempts          Int      @default(0)

  @@index([userId])
  @@index([emailId])
  @@index([resolved])
  @@map("dead_letter_emails")
}

model GmailSyncQueue {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  legacyUserId String    @map("legacy_user_id")
  connectionId String    @map("connection_id") @db.Uuid
  syncMode     String    @map("sync_mode")
  priority     Int       @default(0)
  attempts     Int       @default(0)
  maxAttempts  Int       @default(5) @map("max_attempts")
  nextRunAt    DateTime  @default(now()) @map("next_run_at") @db.Timestamptz
  lastError    String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([userId, syncMode], name: "unique_user_sync_mode")
  @@index([nextRunAt, priority])
  @@map("gmail_sync_queue")
}

model MalwareScanResult {
  id             String    @id @default(uuid()) @db.Uuid
  userResumeId   String    @map("user_resume_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  scanner        String
  result         String
  threats        Json?
  scanDurationMs Int?      @map("scan_duration_ms")
  scannedAt      DateTime  @default(now()) @map("scanned_at") @db.Timestamptz
  metadata       Json      @default("{}")

  @@index([userResumeId])
  @@index([userId])
  @@map("malware_scan_results")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMPANIES / OPPORTUNITIES / RECRUITERS
// ─────────────────────────────────────────────────────────────────────────────

model Company {
  id                    String                @id @default(uuid()) @db.Uuid
  name                  String
  normalizedName        String?               @map("normalized_name")
  legalName             String?               @map("legal_name")
  domain                String                @unique
  careersUrl            String?               @map("careers_url")
  website               String?
  logoUrl               String?               @map("logo_url")
  industry              String?
  headquarters          String?
  countryCode           String?               @map("country_code")
  jurisdictionCode      String?               @map("jurisdiction_code")
  companyStatus         String?               @map("company_status")
  companyType           String?               @map("company_type")
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz
  aliases               CompanyAlias[]
  identifiers           CompanyIdentifier[]
  domains               CompanyDomain[]
  sourceRecords         CompanySourceRecord[]
  outgoingRelationships CompanyRelationship[] @relation("CompanyRelationshipFrom")
  incomingRelationships CompanyRelationship[] @relation("CompanyRelationshipTo")
  recruiters            Recruiter[]
  opportunities         Opportunity[]
  opportunityLinks      OpportunityCompanyLink[]
  applications          JobApplication[]
  companySignals        CompanySignal[]
  observations          EntityObservation[]   @relation("CompanyEntityObservations")

  @@index([name])
  @@index([normalizedName])
  @@index([countryCode, jurisdictionCode])
  @@map("companies")
}

model CompanyAlias {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  value           String
  normalizedValue String   @unique @map("normalized_value")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_aliases")
}

model CompanyIdentifier {
  id               String           @id @default(uuid()) @db.Uuid
  companyId        String           @map("company_id") @db.Uuid
  sourceId         String           @map("source_id") @db.Uuid
  identifierType   String           @map("identifier_type")
  value            String
  normalizedValue  String           @map("normalized_value")
  countryCode      String?          @map("country_code")
  jurisdictionCode String?          @map("jurisdiction_code")
  isPrimary        Boolean          @default(false) @map("is_primary")
  metadata         Json             @default("{}")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source           IntelligenceSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, identifierType, normalizedValue], name: "unique_company_identifier_per_source")
  @@index([companyId])
  @@index([identifierType, normalizedValue])
  @@index([countryCode, jurisdictionCode])
  @@map("company_identifiers")
}

model CompanyDomain {
  id               String             @id @default(uuid()) @db.Uuid
  companyId        String             @map("company_id") @db.Uuid
  sourceId         String?            @map("source_id") @db.Uuid
  domain           String
  normalizedDomain String             @unique @map("normalized_domain")
  domainType       String             @default("PRIMARY") @map("domain_type")
  isPrimary        Boolean            @default(false) @map("is_primary")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source           IntelligenceSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([sourceId])
  @@index([isPrimary])
  @@map("company_domains")
}

model CompanySourceRecord {
  id                 String              @id @default(uuid()) @db.Uuid
  companyId          String              @map("company_id") @db.Uuid
  sourceId           String              @map("source_id") @db.Uuid
  datasetVersionId   String?             @map("dataset_version_id") @db.Uuid
  externalRecordId   String              @map("external_record_id")
  sourceUrl          String?             @map("source_url")
  sourceVersion      String?             @map("source_version")
  observedAt         DateTime            @map("observed_at") @db.Timestamptz
  publishedAt        DateTime?           @map("published_at") @db.Timestamptz
  retrievedAt        DateTime?           @map("retrieved_at") @db.Timestamptz
  contentHash        String?             @map("content_hash")
  rawReference       String?             @map("raw_reference")
  status             SourceRecordStatus  @default(ACTIVE)
  metadata           Json                @default("{}")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source             IntelligenceSource  @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  datasetVersion     DatasetVersion?     @relation(fields: [datasetVersionId], references: [id], onDelete: SetNull)
  companyRelationships CompanyRelationship[]

  @@unique([sourceId, externalRecordId], name: "unique_company_source_record")
  @@index([companyId, observedAt])
  @@index([sourceId, status])
  @@index([datasetVersionId])
  @@map("company_source_records")
}

model CompanyRelationship {
  id             String                  @id @default(uuid()) @db.Uuid
  fromCompanyId  String                  @map("from_company_id") @db.Uuid
  toCompanyId    String                  @map("to_company_id") @db.Uuid
  relationshipType CompanyRelationshipType @map("relationship_type")
  sourceRecordId String?                 @map("source_record_id") @db.Uuid
  provenanceId   String?                 @map("provenance_id") @db.Uuid
  validFrom      DateTime?               @map("valid_from") @db.Timestamptz
  validTo        DateTime?               @map("valid_to") @db.Timestamptz
  isCurrent      Boolean                 @default(true) @map("is_current")
  metadata       Json                    @default("{}")
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz
  fromCompany    Company                 @relation("CompanyRelationshipFrom", fields: [fromCompanyId], references: [id], onDelete: Cascade)
  toCompany      Company                 @relation("CompanyRelationshipTo", fields: [toCompanyId], references: [id], onDelete: Cascade)
  sourceRecord   CompanySourceRecord?    @relation(fields: [sourceRecordId], references: [id], onDelete: SetNull)
  provenance     IntelligenceProvenance? @relation(fields: [provenanceId], references: [id], onDelete: SetNull)

  @@index([fromCompanyId, relationshipType, isCurrent])
  @@index([toCompanyId, relationshipType, isCurrent])
  @@index([sourceRecordId])
  @@index([provenanceId])
  @@map("company_relationships")
}

model Recruiter {
  id           String           @id @default(uuid()) @db.Uuid
  companyId    String           @map("company_id") @db.Uuid
  name         String
  email        String
  title        String
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  emails       EmailMessage[]
  applications JobApplication[]

  @@unique([companyId, email], name: "unique_company_recruiter_email")
  @@index([companyId])
  @@index([email])
  @@map("recruiters")
}

model Opportunity {
  id                 String                 @id @default(uuid()) @db.Uuid
  companyId          String                 @map("company_id") @db.Uuid
  externalId         String?                @map("external_id")
  title              String
  normalizedTitle    String                 @map("normalized_title")
  description        String?                @db.Text
  location           String?
  normalizedLocation String                 @map("normalized_location") @default("")
  salaryRange        String?                @map("salary_range")
  employmentType     String?                @map("employment_type")
  workSetting        String?                @map("work_setting")
  canonicalStatus    String                 @default("OPEN") @map("canonical_status")
  countryCode        String?                @map("country_code")
  languageCode       String?                @map("language_code")
  url                String?
  requirements       Json                   @default("[]")
  sourceMetadata     Json?                  @map("source_metadata")
  postedAt           DateTime?              @map("posted_at") @db.Timestamptz
  expiresAt          DateTime?              @map("expires_at") @db.Timestamptz
  firstSeenAt        DateTime?              @map("first_seen_at") @db.Timestamptz
  lastSeenAt         DateTime?              @map("last_seen_at") @db.Timestamptz
  isCurrent          Boolean                @default(true) @map("is_current")
  careersPageUrl     String?                @map("careers_page_url")
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz
  company            Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyLinks       OpportunityCompanyLink[]
  sourceRecords      OpportunitySourceRecord[]
  applications       JobApplication[]
  factObservations   FactObservation[]
  extractionRuns     ExtractionRun[]
  predictions        Prediction[]
  actionEvents       ActionEvent[]
  observations       OpportunityObservation[]
