// ─────────────────────────────────────────────────────────────────────────────
// PROMPTS 9–12 — Facts, Snapshots, Outcomes (Intelligence & Scale Foundation)
// ─────────────────────────────────────────────────────────────────────────────

/// Stores individual pieces of structured intelligence with full provenance and versioning.
model FactObservation {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  extractionRunId   String  @map("extraction_run_id") @db.Uuid
  provenanceId      String  @unique @map("provenance_id") @db.Uuid
  factType          String  @map("fact_type")
  factData          Json    @map("fact_data")
  sourceType        String  @map("source_type")
  sourceId          String  @map("source_id")
  sourceVersion     String? @map("source_version")
  extractionMethod  String  @map("extraction_method")
  modelVersion      String? @map("model_version")
  confidence        Float   @default(1.0)
  evidenceReference String? @map("evidence_reference") @db.Text

  // Temporal validity (Prompt 10)
  validFrom DateTime? @map("valid_from") @db.Timestamptz
  validTo   DateTime? @map("valid_to") @db.Timestamptz

  // Observation context (Prompt 10)
  observedAt DateTime @map("observed_at") @db.Timestamptz
  snapshotId String?  @map("snapshot_id") @db.Uuid

  extractedAt DateTime @default(now()) @map("extracted_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Versioning fields
  version        Int       @default(1)
  isCurrent      Boolean   @default(true) @map("is_current")
  supersededById String?   @map("superseded_by_id") @db.Uuid
  supersededAt   DateTime? @map("superseded_at") @db.Timestamptz

  // Correction fields (Prompt 11)
  correctedBy      String?   @map("corrected_by") @db.Uuid
  correctedAt      DateTime? @map("corrected_at") @db.Timestamptz
  correctionReason String?   @map("correction_reason") @db.Text
  isUserCorrected  Boolean   @default(false) @map("is_user_corrected")

  // Review fields (Prompt 11)
  needsReview  Boolean   @default(false) @map("needs_review")
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz
  reviewedBy   String?   @map("reviewed_by") @db.Uuid
  reviewStatus String?   @map("review_status")
  reviewNotes  String?   @map("review_notes") @db.Text

  // Soft deletion
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  user                  User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  extractionRun         ExtractionRun                    @relation(fields: [extractionRunId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  provenance            FactProvenance                   @relation(fields: [provenanceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  snapshot              Snapshot?                        @relation(fields: [snapshotId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  supersededBy          FactObservation?                 @relation("FactVersionChain", fields: [supersededById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  supersedes            FactObservation[]                @relation("FactVersionChain")
  correctedByUser       User?                            @relation("FactCorrectedBy", fields: [correctedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reviewedByUser        User?                            @relation("FactReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)
  canonicalIntelligence CanonicalCandidateIntelligence[] @relation("CanonicalSourceFact")

  @@index([userId, factType, isCurrent])
  @@index([userId, isCurrent])
  @@index([sourceId, sourceType])
  @@index([userId, observedAt])
  @@index([extractionRunId])
  @@index([snapshotId])
  @@index([needsReview, reviewStatus])
  @@index([validFrom])
  @@index([validTo])
  @@map("fact_observations")
}

model ExtractionRun {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  cellId         String    @map("cell_id")
  sourceType     String    @map("source_type")
  sourceId       String    @map("source_id")
  sourceVersion  String?   @map("source_version")
  sourceIdentity String?   @map("source_identity")
  parserVersion  String    @map("parser_version")
  modelProvider  String?   @map("model_provider")
  modelVersion   String?   @map("model_version")
  promptVersion  String?   @map("prompt_version")
  schemaVersion  String    @map("schema_version")
  status         String    @default("pending")
  failureReason  String?   @map("failure_reason") @db.Text
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz
  completedAt    DateTime? @map("completed_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  provenance FactProvenance[]
  facts      FactObservation[]

  @@index([userId])
  @@index([cellId])
  @@index([sourceType, sourceId])
  @@map("extraction_runs")
}

model FactProvenance {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  cellId          String   @map("cell_id")
  sourceType      String   @map("source_type")
  sourceId        String   @map("source_id")
  sourceVersion   String?  @map("source_version")
  sourceIdentity  String?  @map("source_identity")
  extractionRunId String   @unique @map("extraction_run_id") @db.Uuid
  parserVersion   String   @map("parser_version")
  modelProvider   String?  @map("model_provider")
  modelVersion    String?  @map("model_version")
  promptVersion   String?  @map("prompt_version")
  schemaVersion   String   @map("schema_version")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  user                  User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  extractionRun         ExtractionRun                    @relation(fields: [extractionRunId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  facts                 FactObservation[]
  canonicalIntelligence CanonicalCandidateIntelligence[] @relation("CanonicalProvenance")

  @@index([userId])
  @@index([cellId])
  @@map("fact_provenance")
}

// ─────────────────────────────────────────────────────────────────────────────
// CANONICAL CANDIDATE INTELLIGENCE (Epic 4 Prompt 4)
// ─────────────────────────────────────────────────────────────────────────────

/// One canonical current record per (userId, factType, deduplicationKey).
/// Points to the winning FactObservation — does NOT copy raw data.
/// Updated when a higher-confidence or more-recent extraction supersedes it.
model CanonicalCandidateIntelligence {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  cellId String @map("cell_id")

  /// Semantic category (SKILL, EXPERIENCE, EDUCATION, PROJECT, CERTIFICATION, …)
  factType String @map("fact_type")

  /// Stable key that determines uniqueness within a factType for a user.
  /// For SKILL: normalised skill name.
  /// For EXPERIENCE/EDUCATION/PROJECT/CERTIFICATION: content hash of key fields.
  /// This is NOT the fact data — it is only the deduplication discriminator.
  deduplicationKey String @map("deduplication_key")

  /// FK to the winning FactObservation.  RESTRICT prevents orphan canonical rows.
  sourceFactId String @map("source_fact_id") @db.Uuid

  /// FK to the FactProvenance of the winning run — kept for quick provenance
  /// look-up without joining through FactObservation.
  provenanceId String @map("provenance_id") @db.Uuid

  /// Confidence of the winning fact [0, 1].
  confidence Float @default(1.0)

  /// observedAt copied from the winning FactObservation so the read model can
  /// answer "when was this last confirmed?" without a join.
  lastObservedAt DateTime @map("last_observed_at") @db.Timestamptz

  /// sourceVersion of the winning extraction run's source document.
  sourceVersion String? @map("source_version")

  /// Whether this record is logically active (false = soft-retired).
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceFact FactObservation @relation("CanonicalSourceFact", fields: [sourceFactId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  provenance FactProvenance  @relation("CanonicalProvenance", fields: [provenanceId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// One active canonical record per user × factType × deduplicationKey.
  @@unique([userId, factType, deduplicationKey], name: "unique_canonical_per_user_type_key")
  @@index([userId, factType, isActive])
  @@index([userId, isActive])
  @@index([sourceFactId])
  @@index([provenanceId])
  @@index([cellId])
  @@map("canonical_candidate_intelligence")
}

model Snapshot {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  snapshotType     String            @map("snapshot_type")
  referenceId      String?           @map("reference_id") @db.Uuid
  capturedAt       DateTime          @default(now()) @map("captured_at") @db.Timestamptz
  description      String?           @db.Text
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  factObservations FactObservation[]
  applications     JobApplication[]

  @@index([userId, snapshotType])
  @@index([referenceId])
  @@index([capturedAt])
  @@map("snapshots")
}

/// Stores outcome events for job applications (Prompt 12)
model OutcomeEvent {
  id              String  @id @default(uuid()) @db.Uuid
  applicationId   String  @map("application_id") @db.Uuid
  userId          String  @map("user_id") @db.Uuid
  outcomeType     String  @map("outcome_type")
  outcomeCategory String  @map("outcome_category")
  outcomeStatus   String  @map("outcome_status")
  explicit        Boolean

  // Metadata
  sourceType String  @map("source_type")
  sourceId   String? @map("source_id")
  sourceData Json?   @map("source_data")

  // Evidence (for trust)
  evidence   String? @db.Text
  confidence Float

  // Temporal
  occurredAt DateTime @map("occurred_at") @db.Timestamptz
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz

  // Derived status (for backward compatibility)
  resultingStatus String? @map("resulting_status")

  // Versioning
  version        Int       @default(1)
  supersededById String?   @map("superseded_by_id") @db.Uuid
  isCurrent      Boolean   @default(true) @map("is_current")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([userId])
  @@index([occurredAt])
  @@index([outcomeType])
  @@index([userId, outcomeType, occurredAt])
  @@map("outcome_events")
}

/// Stores user actions and strategy metadata (Prompt 13).
model ActionEvent {
  id            String  @id @default(uuid()) @db.Uuid
  userId        String  @map("user_id") @db.Uuid
  applicationId String? @map("application_id") @db.Uuid
  opportunityId String? @map("opportunity_id") @db.Uuid

  // Action details
  actionType    String  @map("action_type")
  actionSubtype String? @map("action_subtype")

  // Strategy metadata
  strategyTags String[] @default([]) @map("strategy_tags")
  context      Json?

  // Source
  sourceType String  @default("USER_ACTION") @map("source_type")
  sourceId   String? @map("source_id")

  // Temporal
  occurredAt DateTime @map("occurred_at") @db.Timestamptz
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz

  // Metadata
  notes      String? @db.Text
  confidence Float?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  application JobApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  opportunity Opportunity?    @relation(fields: [opportunityId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId])
  @@index([applicationId])
  @@index([opportunityId])
  @@index([actionType])
  @@index([occurredAt])
  @@map("action_events")
}

