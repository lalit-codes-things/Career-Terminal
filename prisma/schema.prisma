generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum EmailProvider {
  GMAIL
  OUTLOOK
}

enum ConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

enum ApplicationStatus {
  SAVED
  APPLIED
  SCREENING
  ASSESSMENT
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum ApplicationSourceProvider {
  GMAIL
  MANUAL
  OUTLOOK
  CSV
  API
}

enum JobType {
  GMAIL_INITIAL_SYNC
  GMAIL_INCREMENTAL_SYNC
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum ApplicationTimelineEventType {
  APPLICATION_SUBMITTED
  APPLICATION_CONFIRMED
  RECRUITER_CONTACT
  ASSESSMENT
  ASSESSMENT_COMPLETED
  PHONE_SCREEN
  INTERVIEW
  FINAL_INTERVIEW
  OFFER
  REJECTION
  WITHDRAWN
}

enum CellStatus {
  ACTIVE
  DRAINING
  READ_ONLY
  MIGRATING
  DISABLED
}

enum CellLifecycleState {
  PROVISIONING
  ACTIVE
  DRAINING
  MIGRATING
  DISABLED
}

enum CellRoutingState {
  ROUTABLE
  WRITE_BLOCKED
  READ_ONLY
  UNROUTABLE
}

// ─────────────────────────────────────────────────────────────────────────────
// IDENTITY / TENANCY
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String?   @unique
  name                String?
  cellId              String?   @map("cell_id")
  region              String    @default("us-east-1")
  dataResidencyRegion String    @default("us-east-1") @map("data_residency_region")
  shardKey            Int       @default(0) @map("shard_key")
  tenantId            String?   @map("tenant_id") @db.Uuid
  consentVersion      String    @default("v1") @map("consent_version")
  consentGrantedAt    DateTime  @default(now()) @map("consent_granted_at") @db.Timestamptz
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz
  deletionStatus      String    @default("active") @map("deletion_status")
  deletionRequestedAt DateTime? @map("deletion_requested_at") @db.Timestamptz
  deletionCompletedAt DateTime? @map("deletion_completed_at") @db.Timestamptz
  legalHoldReason     String?   @map("legal_hold_reason") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  connections           UserEmailConnection[]
  syncStates            GmailSyncState[]
  candidateProfile      CandidateProfile?
  idMappings            UserIdMapping[]
  syncJobs              SyncJob[]
  jobApplications       JobApplication[]
  userResumes           UserResume[]
  resumes               Resume[]
  checkpoint            GmailCheckpoint?
  syncBatches           SyncBatch[]
  snapshots             Snapshot[]
  factObservations      FactObservation[]
  extractionRuns        ExtractionRun[]
  factProvenance        FactProvenance[]
  outcomeEvents         OutcomeEvent[]
  actionEvents          ActionEvent[]
  predictions           Prediction[]
  predictionFeedback    PredictionFeedback[]
  correctedFacts        FactObservation[]                @relation("FactCorrectedBy")
  reviewedFacts         FactObservation[]                @relation("FactReviewedBy")
  homeCell              Cell?                            @relation(fields: [cellId], references: [id], onDelete: SetNull)
  canonicalIntelligence CanonicalCandidateIntelligence[]
  events                Event[]
  opportunityObservations OpportunityObservation[]

  @@index([region])
  @@index([deletionStatus])
  @@index([shardKey])
  @@index([tenantId])
  @@index([dataResidencyRegion])
  @@index([cellId])
  @@map("users")
}

model Cell {
  id                String             @id
  region            String
  residencyPolicyId String?            @map("residency_policy_id")
  status            CellStatus         @default(ACTIVE)
  lifecycleState    CellLifecycleState @default(ACTIVE) @map("lifecycle_state")
  routingState      CellRoutingState   @default(ROUTABLE) @map("routing_state")
  capacityState     String?            @map("capacity_state")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  users User[]

  @@index([region])
  @@index([status])
  @@index([routingState])
  @@map("cells")
}

model CandidateProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  fullName    String?  @map("full_name")
  phone       String?
  location    String?
  timezone    String?
  preferences Json     @default("{}")
  careerGoals Json?    @map("career_goals")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("candidate_profiles")
}

model UserIdMapping {
  id         String   @id @default(uuid()) @db.Uuid
  externalId String   @unique @map("external_id")
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_id_mapping")
}

// ─────────────────────────────────────────────────────────────────────────────
// EMAIL CONNECTIONS / SYNC STATE
// ─────────────────────────────────────────────────────────────────────────────

model UserEmailConnection {
  id                    String           @id @default(uuid()) @db.Uuid
  userId                String           @map("user_id") @db.Uuid
  legacyUserId          String           @map("legacy_user_id")
  provider              EmailProvider
  emailAddress          String           @map("email_address")
  accessTokenEncrypted  String           @map("access_token_encrypted")
  refreshTokenEncrypted String           @map("refresh_token_encrypted")
  tokenExpiry           DateTime         @map("token_expiry") @db.Timestamptz
  scopes                String[]
  status                ConnectionStatus @default(ACTIVE)
  expiresAt             DateTime         @default(now()) @map("expires_at") @db.Timestamptz
  lastSyncAt            DateTime?        @map("last_sync_at") @db.Timestamptz
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncStates            GmailSyncState[]

  @@unique([legacyUserId, provider, emailAddress], name: "unique_user_provider_email")
  @@index([userId])
  @@index([provider])
  @@index([status])
  @@map("user_email_connections")
}

model GmailSyncState {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @unique @map("user_id") @db.Uuid
  legacyUserId String              @unique @map("legacy_user_id")
  connectionId String              @map("connection_id") @db.Uuid
  historyId    String              @map("history_id")
  lastSyncedAt DateTime            @default(now()) @map("last_synced_at") @db.Timestamptz
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection   UserEmailConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("gmail_sync_states")
}

model GmailCheckpoint {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  currentHistoryId String?  @map("current_history_id")
  pendingHistoryId String?  @map("pending_history_id")
  status           String   @default("idle")
  lastSyncAt       DateTime @default(now()) @map("last_sync_at") @db.Timestamptz
  lastError        String?  @map("last_error") @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("gmail_checkpoints")
}

model SyncJob {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  legacyUserId String    @map("legacy_user_id")
  type         JobType
  status       JobStatus @default(PENDING)
  attempts     Int       @default(0)
  startedAt    DateTime? @map("started_at") @db.Timestamptz
  completedAt  DateTime? @map("completed_at") @db.Timestamptz
  nextRunAt    DateTime  @default(now()) @map("next_run_at") @db.Timestamptz
  error        String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, nextRunAt])
  @@index([userId])
  @@map("sync_jobs")
}

model SyncBatch {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  historyId      String          @map("history_id")
  status         String          @default("pending")
  totalEmails    Int?            @map("total_emails")
  processedCount Int             @default(0) @map("processed_count")
  failedCount    Int             @default(0) @map("failed_count")
  startedAt      DateTime        @default(now()) @map("started_at") @db.Timestamptz
  completedAt    DateTime?       @map("completed_at") @db.Timestamptz
  error          String?         @db.Text
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailJobs      BatchEmailJob[]

  @@index([userId])
  @@index([status])
  @@map("sync_batches")
}

model BatchEmailJob {
  id                String    @id @default(uuid()) @db.Uuid
  batchId           String    @map("batch_id") @db.Uuid
  emailId           String    @map("email_id") @db.Uuid
  providerMessageId String    @map("provider_message_id")
  status            String    @default("pending")
  attempts          Int       @default(0)
  lastError         String?   @map("last_error") @db.Text
  processedAt       DateTime? @map("processed_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  batch             SyncBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([status])
  @@map("batch_email_jobs")
}

model DeadLetterEmail {
  id                String   @id @default(uuid()) @db.Uuid
  emailId           String   @map("email_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  providerMessageId String   @map("provider_message_id")
  error             String   @db.Text
  failedAt          DateTime @default(now()) @map("failed_at") @db.Timestamptz
  resolved          Boolean  @default(false)
  attempts          Int      @default(0)

  @@index([userId])
  @@index([emailId])
  @@index([resolved])
  @@map("dead_letter_emails")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMPANIES / OPPORTUNITIES / RECRUITERS
// ─────────────────────────────────────────────────────────────────────────────

model Company {
  id            String           @id @default(uuid()) @db.Uuid
  name          String
  domain        String           @unique
  careersUrl    String?          @map("careers_url")
  website       String?
  logoUrl       String?          @map("logo_url")
  industry      String?
  headquarters  String?
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  aliases       CompanyAlias[]
  recruiters    Recruiter[]
  opportunities Opportunity[]
  applications  JobApplication[]

  @@index([name])
  @@map("companies")
}

model CompanyAlias {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  value           String
  normalizedValue String   @unique @map("normalized_value")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_aliases")
}

model Recruiter {
  id           String           @id @default(uuid()) @db.Uuid
  companyId    String           @map("company_id") @db.Uuid
  name         String
  email        String
  title        String
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  emails       EmailMessage[]
  applications JobApplication[]

  @@unique([companyId, email], name: "unique_company_recruiter_email")
  @@index([companyId])
  @@index([email])
  @@map("recruiters")
}

model Opportunity {
  id                String           @id @default(uuid()) @db.Uuid
  companyId         String           @map("company_id") @db.Uuid
  externalId        String?          @map("external_id")
  title             String
  description       String?          @db.Text
  location          String?
  salaryRange       String?          @map("salary_range")
  employmentType    String?          @map("employment_type")
  workSetting       String?          @map("work_setting")
  url               String?
  requirements      Json             @default("[]")
  sourceMetadata    Json?            @map("source_metadata")
  postedAt          DateTime?        @map("posted_at") @db.Timestamptz
  expiresAt         DateTime?        @map("expires_at") @db.Timestamptz
  firstSeenAt       DateTime?        @map("first_seen_at") @db.Timestamptz
  lastSeenAt        DateTime?        @map("last_seen_at") @db.Timestamptz
  isCurrent         Boolean          @default(true) @map("is_current")
  careersPageUrl    String?          @map("careers_page_url")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications      JobApplication[]
  factObservations  FactObservation[]
  extractionRuns    ExtractionRun[]
  predictions       Prediction[]
  actionEvents      ActionEvent[]
  observations      OpportunityObservation[]

  @@index([companyId])
  @@index([title])
  @@index([location])
  @@map("opportunities")
}

model OpportunityObservation {
  id               String   @id @default(uuid()) @db.Uuid
  opportunityId    String   @map("opportunity_id") @db.Uuid
  userId           String?  @map("user_id") @db.Uuid
  sourceType       String   @map("source_type")
  sourceId         String   @map("source_id")
  extractionRunId  String?  @map("extraction_run_id") @db.Uuid
  observedAt       DateTime @default(now()) @map("observed_at") @db.Timestamptz
  title            String?
  description      String?  @db.Text
  location         String?
  compensation     Json?
  requirements     Json?    @default("[]")
  department       String?
  employmentType   String?  @map("employment_type")
  remotePolicy     String?  @map("remote_policy")
  seniority        String?
  hiringInfo       Json?    @map("hiring_info") @default("{}")
  confidence       Float    @default(1.0)
  url              String?
  isCurrent        Boolean  @default(true) @map("is_current")
  supersededById   String?  @map("superseded_by_id") @db.Uuid
  supersededAt     DateTime? @map("superseded_at") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  opportunity  Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  supersededBy OpportunityObservation? @relation("ObservationSuperseded", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   OpportunityObservation[] @relation("ObservationSuperseded")

  @@index([opportunityId])
  @@index([userId])
  @@index([observedAt])
  @@index([opportunityId, observedAt])
  @@map("opportunity_observations")
}

model JobApplication {
  id                  String                      @id @default(uuid()) @db.Uuid
  userId              String                      @map("user_id") @db.Uuid
  legacyUserId        String?                     @map("legacy_user_id")
  companyId           String?                     @map("company_id") @db.Uuid
  opportunityId       String?                     @map("opportunity_id") @db.Uuid
  recruiterId         String?                     @map("recruiter_id") @db.Uuid
  snapshotId          String?                     @map("snapshot_id") @db.Uuid
  companyName         String?                     @map("company_name")
  companyDomain       String?                     @map("company_domain")
  roleTitle           String?                     @map("role_title")
  roleDepartment      String?                     @map("role_department")
  status              ApplicationStatus           @default(SAVED)
  sourceProvider      ApplicationSourceProvider   @default(MANUAL) @map("source_provider")
  appliedAt           DateTime?                   @map("applied_at") @db.Timestamptz
  appliedDate         DateTime?                   @map("applied_date") @db.Timestamptz
  lastActivityAt      DateTime                    @default(now()) @map("last_activity_at") @db.Timestamptz
  recruiterName       String?                     @map("recruiter_name")
  recruiterEmail      String?                     @map("recruiter_email")
  sourceEmailId       String?                     @map("source_email_id")
  location            String?
  employmentType      String?                     @map("employment_type")
  currentStage        String?                     @map("current_stage")
  interviewRounds     Int                         @default(0) @map("interview_rounds")
  deadlines           String[]                    @default([])
  threadIds           String[]                    @default([]) @map("thread_ids")
  atsApplicationId    String?                     @map("ats_application_id")
  candidateEmail      String?                     @map("candidate_email")
  metadata            Json                        @default("{}")
  createdAt           DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime                    @updatedAt @map("updated_at") @db.Timestamptz
  user                User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  company             Company?                    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  opportunity         Opportunity?                @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  recruiter           Recruiter?                  @relation(fields: [recruiterId], references: [id], onDelete: SetNull)
  snapshot            Snapshot?                   @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  emailMessages       EmailMessage[]
  timeline            ApplicationTimeline[]
  resumes             Resume[]
  factObservations    FactObservation[]
  extractionRuns      ExtractionRun[]
  predictions         Prediction[]
  outcomeEvents       OutcomeEvent[]
  actionEvents        ActionEvent[]
  applicationSource   ApplicationSource?
  statusHistory       ApplicationStatusHistory[]
  applicationResumes  ApplicationResume[]

  @@index([userId])
  @@index([companyId])
  @@index([opportunityId])
  @@index([status])
  @@index([snapshotId])
  @@map("job_applications")
}

model ApplicationTimeline {
  id            String                       @id @default(uuid()) @db.Uuid
  applicationId String                       @map("application_id") @db.Uuid
  eventType     ApplicationTimelineEventType @map("event_type")
  timestamp     DateTime                     @map("timestamp") @db.Timestamptz
  occurredAt    DateTime                     @map("occurred_at") @db.Timestamptz
  sourceEmailId String?                      @map("source_email_id")
  description   String?
  metadata      Json                         @default("{}")
  createdAt     DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  application   JobApplication               @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([occurredAt])
  @@map("application_timeline_events")
}

model ApplicationSource {
  id            String         @id @default(uuid()) @db.Uuid
  applicationId String         @unique @map("application_id") @db.Uuid
  provider      String
  sourceEmailId String?        @map("source_email_id")
  sourceData    Json?          @map("source_data")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_sources")
}

model ApplicationStatusHistory {
  id              String         @id @default(uuid()) @db.Uuid
  applicationId   String         @map("application_id") @db.Uuid
  previousStatus  String?        @map("previous_status")
  status          String
  source          String
  sourceEmailId   String?        @map("source_email_id")
  changedByUserId String?        @map("changed_by_user_id")
  timestamp       DateTime       @map("timestamp") @db.Timestamptz
  metadata        Json           @default("{}")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  application     JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([timestamp])
  @@map("application_status_history")
}

// ─────────────────────────────────────────────────────────────────────────────
// EMAIL / MESSAGES
// ─────────────────────────────────────────────────────────────────────────────

model EmailMessage {
  id                String         @id @default(uuid()) @db.Uuid
  applicationId     String?        @map("application_id") @db.Uuid
  recruiterId       String?        @map("recruiter_id") @db.Uuid
  userId            String?        @map("user_id") @db.Uuid
  legacyUserId      String?        @map("legacy_user_id")
  connectionId      String?        @map("connection_id") @db.Uuid
  providerMessageId String         @map("provider_message_id")
  threadId          String         @map("thread_id")
  subject           String?
  snippet           String?        @db.Text
  body              String?        @db.Text
  bodyText          String?        @map("body_text") @db.Text
  bodyHtml          String?        @map("body_html") @db.Text
  from              String?
  to                String[]
  labels            Json           @default("[]")
  receivedAt        DateTime       @map("received_at") @db.Timestamptz
  isRead            Boolean        @default(false) @map("is_read")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  application       JobApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  recruiter         Recruiter?     @relation(fields: [recruiterId], references: [id], onDelete: SetNull)
  attachments       EmailAttachment[]
  factObservations  FactObservation[]
  extractionRuns    ExtractionRun[]

  @@unique([legacyUserId, providerMessageId], name: "unique_user_message")
  @@index([applicationId])
  @@index([recruiterId])
  @@index([threadId])
  @@index([receivedAt])
  @@map("email_messages")
}

model EmailAttachment {
  id             String       @id @default(uuid()) @db.Uuid
  emailMessageId String       @map("email_message_id") @db.Uuid
  filename       String
  contentType    String       @map("content_type")
  size           Int
  s3Key          String       @map("s3_key")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  emailMessage   EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)

  @@index([emailMessageId])
  @@map("email_attachments")
}

model IdempotencyRecord {
  id            String   @id @default(uuid()) @db.Uuid
  key           String   @unique
  operationType String   @map("operation_type")
  resultId      String   @map("result_id")
  resultData    Json?    @map("result_data")
  expiresAt     DateTime @map("expires_at") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([expiresAt])
  @@map("idempotency_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// RESUMES / ARTIFACTS
// ─────────────────────────────────────────────────────────────────────────────

model UserResume {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  legacyUserId   String?   @map("legacy_user_id")
  resumeHashId   String?   @map("resume_hash_id") @db.Uuid
  filename       String
  originalName   String?   @map("original_name")
  s3Key          String    @map("s3_key")
  contentType    String    @map("content_type")
  isPrimary      Boolean   @default(false) @map("is_primary")
  isActive       Boolean   @default(true) @map("is_active")
  version        Int       @default(1)
  supersededAt   DateTime? @map("superseded_at") @db.Timestamptz
  scanningStatus String?   @map("scanning_status")
  status         String?   @default("pending")
  parsedContent  Json?     @map("parsed_content")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeHash     ResumeHash? @relation(fields: [resumeHashId], references: [id], onDelete: SetNull)
  applicationLinks ApplicationResume[]

  @@index([userId])
  @@index([isActive])
  @@map("user_resumes")
}

model ResumeHash {
  id        String   @id @default(uuid()) @db.Uuid
  hash      String   @unique
  storageKey String  @map("storage_key")
  storageUrl String  @map("storage_url")
  mimeType  String   @map("mime_type")
  sizeBytes Int      @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  resumes   UserResume[]

  @@map("resume_hashes")
}

model ApplicationResume {
  applicationId       String     @map("application_id") @db.Uuid
  resumeVersionId     String     @map("resume_version_id") @db.Uuid
  snapshotKey         String     @map("snapshot_key")
  snapshotMetadata    Json       @default("{}") @map("snapshot_metadata")
  appliedAt           DateTime?  @map("applied_at") @db.Timestamptz
  usageContext        Json       @default("{}") @map("usage_context")
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz
  application         JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  resumeVersion       UserResume @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)

  @@id([applicationId, resumeVersionId])
  @@map("application_resumes")
}

model Resume {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  legacyUserId    String?         @map("legacy_user_id")
  applicationId   String?         @map("application_id") @db.Uuid
  resumeVersionId String?         @map("resume_version_id") @db.Uuid
  filename        String
  s3Key           String          @map("s3_key")
  contentType     String          @map("content_type")
  parsedContent   Json?           @map("parsed_content")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  application    JobApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  factObservations FactObservation[]
  extractionRuns   ExtractionRun[]

  @@index([userId])
  @@index([applicationId])
  @@map("resumes")
}

// ─────────────────────────────────────────────────────────────────────────────
// KNOWLEDGE GRAPH / CANONICAL INTELLIGENCE
// ─────────────────────────────────────────────────────────────────────────────

model FactObservation {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  factType          String   @map("fact_type")
  factData          Json     @map("fact_data")
  sourceType        String   @map("source_type")
  sourceId          String   @map("source_id")
  sourceVersion     String?  @map("source_version")
  extractionMethod  String   @map("extraction_method")
  modelVersion      String?  @map("model_version")
  confidence        Float    @default(1.0)
  evidenceReference String?  @map("evidence_reference")
  validFrom         DateTime? @map("valid_from") @db.Timestamptz
  validTo           DateTime? @map("valid_to") @db.Timestamptz
  observedAt        DateTime @default(now()) @map("observed_at") @db.Timestamptz
  snapshotId        String?  @map("snapshot_id") @db.Uuid
  extractedAt       DateTime @default(now()) @map("extracted_at") @db.Timestamptz
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz
  version           Int      @default(1)
  isCurrent         Boolean  @default(true) @map("is_current")
  supersededById    String?  @map("superseded_by_id") @db.Uuid
  supersededAt      DateTime? @map("superseded_at") @db.Timestamptz
  correctedBy       String?  @map("corrected_by") @db.Uuid
  correctedAt       DateTime? @map("corrected_at") @db.Timestamptz
  correctionReason  String?  @map("correction_reason")
  isUserCorrected   Boolean  @default(false) @map("is_user_corrected")
  needsReview       Boolean  @default(false) @map("needs_review")
  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamptz
  reviewedBy        String?  @map("reviewed_by") @db.Uuid
  reviewStatus      String?  @map("review_status")
  reviewNotes       String?  @map("review_notes")
  deduplicationKey  String?  @map("deduplication_key")
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userCorrectedBy  User?           @relation("FactCorrectedBy", fields: [correctedBy], references: [id], onDelete: SetNull)
  userReviewedBy   User?           @relation("FactReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)
  email            EmailMessage?   @relation(fields: [sourceId], references: [id], map: "fact_email_fk", onDelete: Cascade)
  resume           Resume?         @relation(fields: [sourceId], references: [id], map: "fact_resume_fk", onDelete: Cascade)
  opportunity      Opportunity?    @relation(fields: [sourceId], references: [id], map: "fact_opportunity_fk", onDelete: Cascade)
  application      JobApplication? @relation(fields: [sourceId], references: [id], map: "fact_application_fk", onDelete: Cascade)
  snapshot         Snapshot?       @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  supersededBy     FactObservation? @relation("FactSupersededBy", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes       FactObservation[] @relation("FactSupersededBy")
  extractionRunId  String?          @map("extraction_run_id") @db.Uuid
  provenanceId     String?          @map("provenance_id") @db.Uuid
  extractionRun    ExtractionRun?   @relation(fields: [extractionRunId], references: [id], onDelete: SetNull)
  provenance       FactProvenance?  @relation(fields: [provenanceId], references: [id], onDelete: SetNull)
  canonicalLinks   CanonicalCandidateIntelligence[]

  @@index([userId, factType, isCurrent])
  @@index([userId, isCurrent])
  @@index([sourceId, sourceType])
  @@index([userId, observedAt])
  @@index([snapshotId])
  @@index([needsReview, reviewStatus])
  @@map("fact_observations")
}

model Snapshot {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  snapshotType  String   @map("snapshot_type")
  referenceId   String?  @map("reference_id") @db.Uuid
  capturedAt    DateTime @default(now()) @map("captured_at") @db.Timestamptz
  description   String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facts         FactObservation[]
  applications  JobApplication[]

  @@index([userId, snapshotType])
  @@index([referenceId])
  @@index([capturedAt])
  @@map("snapshots")
}

model ExtractionRun {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  cellId           String?  @map("cell_id")
  sourceType       String   @map("source_type")
  sourceId         String   @map("source_id")
  sourceVersion    String?  @map("source_version")
  sourceIdentity   String?  @map("source_identity")
  modelId          String   @map("model_id")
  modelVersion     String?  @map("model_version")
  status           String   @default("pending")
  startedAt        DateTime? @map("started_at") @db.Timestamptz
  completedAt      DateTime? @map("completed_at") @db.Timestamptz
  error            String?   @db.Text
  failureReason    String?   @map("failure_reason") @db.Text
  metadata         Json     @default("{}")
  parserVersion    String?   @map("parser_version")
  modelProvider    String?   @map("model_provider")
  promptVersion    String?   @map("prompt_version")
  schemaVersion    String?   @map("schema_version")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  email            EmailMessage?   @relation(fields: [sourceId], references: [id], map: "extraction_email_fk", onDelete: Cascade)
  resume           Resume?         @relation(fields: [sourceId], references: [id], map: "extraction_resume_fk", onDelete: Cascade)
  opportunity      Opportunity?    @relation(fields: [sourceId], references: [id], map: "extraction_opportunity_fk", onDelete: Cascade)
  application      JobApplication? @relation(fields: [sourceId], references: [id], map: "extraction_application_fk", onDelete: Cascade)
  model            Model           @relation(fields: [modelId], references: [id])
  predictions      Prediction[]
  facts            FactObservation[]
  provenance       FactProvenance?

  @@index([userId])
  @@index([sourceType, sourceId])
  @@map("extraction_runs")
}

model FactProvenance {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  cellId           String?  @map("cell_id")
  sourceType       String   @map("source_type")
  sourceId         String   @map("source_id")
  sourceVersion    String?  @map("source_version")
  sourceIdentity   String?  @map("source_identity")
  extractionRunId  String   @unique @map("extraction_run_id") @db.Uuid
  parserVersion    String?  @map("parser_version")
  modelProvider    String?  @map("model_provider")
  modelVersion     String?  @map("model_version")
  promptVersion    String?  @map("prompt_version")
  schemaVersion    String   @map("schema_version")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  extractionRun    ExtractionRun   @relation(fields: [extractionRunId], references: [id], onDelete: Cascade)
  facts            FactObservation[]
  canonicalLinks   CanonicalCandidateIntelligence[]

  @@index([userId])
  @@map("fact_provenance")
}

model CanonicalCandidateIntelligence {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  cellId           String   @map("cell_id")
  factType         String   @map("fact_type")
  deduplicationKey String   @map("deduplication_key")
  sourceFactId     String   @map("source_fact_id") @db.Uuid
  provenanceId     String   @map("provenance_id") @db.Uuid
  confidence       Float    @default(1.0)
  lastObservedAt   DateTime @map("last_observed_at") @db.Timestamptz
  sourceVersion    String?  @map("source_version")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceFact       FactObservation @relation(fields: [sourceFactId], references: [id], onDelete: Restrict)
  provenance       FactProvenance  @relation(fields: [provenanceId], references: [id], onDelete: Restrict)

  @@unique([userId, factType, deduplicationKey], name: "unique_canonical_per_user_type_key")
  @@index([userId, factType, isActive])
  @@index([userId, isActive])
  @@index([sourceFactId])
  @@index([provenanceId])
  @@index([cellId])
  @@map("canonical_candidate_intelligence")
}

// ─────────────────────────────────────────────────────────────────────────────
// ANALYTICS / PREDICTIONS
// ─────────────────────────────────────────────────────────────────────────────

model OutcomeEvent {
  id               String   @id @default(uuid()) @db.Uuid
  applicationId    String   @map("application_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  outcomeType      String   @map("outcome_type")
  outcomeCategory  String   @map("outcome_category")
  outcomeStatus    String   @map("outcome_status")
  explicit         Boolean
  sourceType       String   @map("source_type")
  sourceId         String?  @map("source_id")
  sourceData       Json?    @map("source_data")
  evidence         String?
  confidence       Float
  occurredAt       DateTime @map("occurred_at") @db.Timestamptz
  recordedAt       DateTime @default(now()) @map("recorded_at") @db.Timestamptz
  resultingStatus  String?  @map("resulting_status")
  version          Int      @default(1)
  supersededById   String?  @map("superseded_by_id") @db.Uuid
  isCurrent        Boolean  @default(true) @map("is_current")
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  application      JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([userId])
  @@index([occurredAt])
  @@index([outcomeType])
  @@index([userId, outcomeType, occurredAt])
  @@map("outcome_events")
}

model ActionEvent {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  applicationId    String?  @map("application_id") @db.Uuid
  opportunityId    String?  @map("opportunity_id") @db.Uuid
  actionType       String   @map("action_type")
  actionSubtype    String?  @map("action_subtype")
  strategyTags     String[] @default([]) @map("strategy_tags")
  context          Json?
  sourceType       String   @default("USER_ACTION") @map("source_type")
  sourceId         String?  @map("source_id")
  occurredAt       DateTime @map("occurred_at") @db.Timestamptz
  recordedAt       DateTime @default(now()) @map("recorded_at") @db.Timestamptz
  notes            String?
  confidence       Float?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  application      JobApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  opportunity      Opportunity?    @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([applicationId])
  @@index([opportunityId])
  @@index([actionType])
  @@index([occurredAt])
  @@map("action_events")
}

model Model {
  id               String   @id
  name             String
  version          String
  provider         String
  capabilities     String[]
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  predictions      Prediction[]
  extractionRuns   ExtractionRun[]

  @@map("models")
}

model Prediction {
  id                String   @id @default(cuid())
  modelId           String   @map("model_id")
  userId            String   @map("user_id") @db.Uuid
  applicationId     String?  @map("application_id") @db.Uuid
  opportunityId     String?  @map("opportunity_id") @db.Uuid
  extractionRunId   String?  @map("extraction_run_id") @db.Uuid
  predictionType    String   @map("prediction_type") // INTERVIEW_PROBABILITY, SALARY_ESTIMATE, SKILL_MATCH
  predictionValue   Json     @map("prediction_value")
  confidenceScore   Float    @map("confidence_score")
  timestamp         DateTime @default(now()) @db.Timestamptz
  isCorrect         Boolean?  @map("is_correct")
  evaluationNote    String?   @map("evaluation_note") @db.Text
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  model       Model                @relation(fields: [modelId], references: [id], onDelete: Cascade)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  application JobApplication?      @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  opportunity Opportunity?         @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
    extractionRun    ExtractionRun?   @relation(fields: [extractionRunId], references: [id], onDelete: SetNull)
  feedback    PredictionFeedback[]

  @@index([modelId])
  @@index([userId])
  @@index([applicationId])
  @@index([predictionType])
  @@index([timestamp])
  @@index([isCorrect])
  @@map("predictions")
}

model PredictionFeedback {
  id           String   @id @default(cuid())
  predictionId String   @map("prediction_id")
  userId       String   @map("user_id") @db.Uuid
  rating       Int?
  helpful      Boolean?
  correct      Boolean?
  comment      String?  @db.Text
  feedbackType String   @map("feedback_type")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  prediction Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([predictionId])
  @@index([userId])
  @@map("prediction_feedback")
}

// ---------------------------------------------------------------------------
// EVENTS & PIPELINE (Epic 4 Prompt 5)
// ---------------------------------------------------------------------------

model Event {
  id            String    @id @default(uuid()) @db.Uuid
  eventType     String    @map("event_type")
  aggregateId   String    @map("aggregate_id")
  aggregateType String    @map("aggregate_type")
  userId        String    @map("user_id") @db.Uuid
  cellId        String    @map("cell_id")
  payload       Json
  status        String    @default("pending") // pending, processed, failed, dlq
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  processedAt   DateTime? @map("processed_at") @db.Timestamptz
  retryCount    Int       @default(0) @map("retry_count")
  correlationId String    @map("correlation_id")
  error         String?   @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([aggregateId, aggregateType])
  @@index([status])
  @@index([correlationId])
  @@map("events")
}

// ---------------------------------------------------------------------------
// CANONICAL ONTOLOGY (Epic 4 Prompt 6)
// ---------------------------------------------------------------------------

model CanonicalOccupation {
  id            String  @id @default(uuid()) @db.Uuid
  canonicalName String  @map("canonical_name")
  source        String // 'ONET', 'ESCO', 'ISCO'
  sourceId      String  @map("source_id")
  sourceVersion String? @map("source_version")

  aliases            CanonicalOccupationAlias[]
  skills             OccupationSkill[]
  parentOccupations  OccupationHierarchy[]      @relation("ParentOccupation")
  childOccupations   OccupationHierarchy[]      @relation("ChildOccupation")
  mappings           OccupationClassificationMapping[]

  @@unique([source, sourceId])
  @@index([canonicalName])
  @@map("canonical_occupations")
}

model CanonicalOccupationAlias {
  id           String @id @default(uuid()) @db.Uuid
  occupationId String @map("occupation_id") @db.Uuid
  alias        String

  occupation CanonicalOccupation @relation(fields: [occupationId], references: [id], onDelete: Cascade)

  @@index([alias])
  @@map("canonical_occupation_aliases")
}

model CanonicalSkill {
  id            String  @id @default(uuid()) @db.Uuid
  canonicalName String  @map("canonical_name")
  skillType     String  @map("skill_type") // SKILL, KNOWLEDGE, ABILITY, LANGUAGE, TRANSVERSAL
  source        String // 'ONET', 'ESCO'
  sourceId      String  @map("source_id")
  sourceVersion String? @map("source_version")

  aliases     CanonicalSkillAlias[]
  occupations OccupationSkill[]
  relatedFrom SkillRelationship[]   @relation("SkillA")
  relatedTo   SkillRelationship[]   @relation("SkillB")

  @@unique([source, sourceId])
  @@index([canonicalName])
  @@index([skillType])
  @@map("canonical_skills")
}

model CanonicalSkillAlias {
  id      String @id @default(uuid()) @db.Uuid
  skillId String @map("skill_id") @db.Uuid
  alias   String

  skill CanonicalSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([alias])
  @@map("canonical_skill_aliases")
}

model CanonicalTask {
  id            String  @id @default(uuid()) @db.Uuid
  description   String
  source        String
  sourceId      String  @map("source_id")
  sourceVersion String? @map("source_version")

  @@unique([source, sourceId])
  @@map("canonical_tasks")
}

model CanonicalWorkActivity {
  id            String  @id @default(uuid()) @db.Uuid
  name          String
  source        String
  sourceId      String  @map("source_id")
  sourceVersion String? @map("source_version")

  @@unique([source, sourceId])
  @@map("canonical_work_activities")
}

model CanonicalIndustry {
  id            String  @id @default(uuid()) @db.Uuid
  code          String
  name          String
  source        String
  sourceId      String  @map("source_id")
  sourceVersion String? @map("source_version")

  @@unique([source, sourceId])
  @@index([code])
  @@map("canonical_industries")
}

model CanonicalCountry {
  id        String @id @default(uuid()) @db.Uuid
  isoAlpha2 String @unique @map("iso_alpha_2")
  isoAlpha3 String @unique @map("iso_alpha_3")
  name      String

  timeZones CanonicalTimeZone[]

  @@map("canonical_countries")
}

model CanonicalLanguage {
  id         String  @id @default(uuid()) @db.Uuid
  iso6391    String  @unique @map("iso_639_1") // Optional in standard, but we'll use empty string if missing
  iso6392    String  @unique @map("iso_639_2")
  name       String
  nativeName String? @map("native_name")

  @@map("canonical_languages")
}

model CanonicalTimeZone {
  id          String @id @default(uuid()) @db.Uuid
  zoneName    String @unique @map("zone_name")
  countryCode String @map("country_code")

  country CanonicalCountry @relation(fields: [countryCode], references: [isoAlpha2], onDelete: Cascade)

  @@map("canonical_time_zones")
}

model OntologySource {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  provider      String
  version       String
  sourceUrl     String?  @map("source_url")
  license       String?
  checksum      String?
  importDate    DateTime @default(now()) @map("import_date") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([name, version])
  @@map("ontology_sources")
}

model OccupationSkill {
  occupationId String  @map("occupation_id") @db.Uuid
  skillId      String  @map("skill_id") @db.Uuid
  importance   Float?
  confidence   Float?
  sourceId     String? @map("source_id")

  occupation CanonicalOccupation @relation(fields: [occupationId], references: [id], onDelete: Cascade)
  skill      CanonicalSkill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([occupationId, skillId])
  @@map("occupation_skill")
}

model SkillRelationship {
  skillA           String  @map("skill_a") @db.Uuid
  skillB           String  @map("skill_b") @db.Uuid
  relationshipType String  @map("relationship_type")
  confidence       Float?
  sourceId         String? @map("source_id")

  skillARef CanonicalSkill @relation("SkillA", fields: [skillA], references: [id], onDelete: Cascade)
  skillBRef CanonicalSkill @relation("SkillB", fields: [skillB], references: [id], onDelete: Cascade)

  @@id([skillA, skillB, relationshipType])
  @@map("skill_relationship")
}

model OccupationHierarchy {
  parent String @db.Uuid
  child  String @db.Uuid

  parentRef CanonicalOccupation @relation("ParentOccupation", fields: [parent], references: [id], onDelete: Cascade)
  childRef  CanonicalOccupation @relation("ChildOccupation", fields: [child], references: [id], onDelete: Cascade)

  @@id([parent, child])
  @@map("occupation_hierarchy")
}

model OccupationClassificationMapping {
  occupationId         String @map("occupation_id") @db.Uuid
  classificationSystem String @map("classification_system")
  externalCode         String @map("external_code")

  occupation CanonicalOccupation @relation(fields: [occupationId], references: [id], onDelete: Cascade)

  @@id([occupationId, classificationSystem, externalCode])
  @@map("occupation_classification_mapping")
}

model CanonicalCurrency {
  id            String  @id @default(uuid()) @db.Uuid
  code          String  @unique
  name          String
  symbol        String?
  minorUnits    Int?    @map("minor_units")
  source        String
  sourceId      String  @map("source_id")
  sourceVersion String? @map("source_version")

  @@map("canonical_currencies")
}
