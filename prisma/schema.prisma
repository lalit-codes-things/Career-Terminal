model Model {
  id           String   @id @default(cuid())
  name         String
  version      String
  provider     String
  description  String?  @db.Text
  modelType    String   @map("model_type")
  parameters   Json?
  inputSchema  Json?    @map("input_schema")
  outputSchema Json?    @map("output_schema")
  isActive     Boolean  @default(true) @map("is_active")
  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  predictions Prediction[]

  @@unique([name, version], name: "unique_model_name_version")
  @@index([name])
  @@index([isActive])
  @@map("models")
}

model Prediction {
  id                String    @id @default(cuid())
  modelId           String    @map("model_id")
  userId            String    @map("user_id") @db.Uuid
  applicationId     String?   @map("application_id") @db.Uuid
  opportunityId     String?   @map("opportunity_id") @db.Uuid
  features          Json
  prediction        Json
  confidence        Float?
  predictionType    String    @map("prediction_type")
  timestamp         DateTime  @default(now()) @map("timestamp") @db.Timestamptz
  actualOutcome     Json?     @map("actual_outcome")
  outcomeObservedAt DateTime? @map("outcome_observed_at") @db.Timestamptz
  isCorrect         Boolean?  @map("is_correct")
  evaluationNote    String?   @map("evaluation_note") @db.Text
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  model       Model                @relation(fields: [modelId], references: [id], onDelete: Cascade)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  application JobApplication?      @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  opportunity Opportunity?         @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  feedback    PredictionFeedback[]

  @@index([modelId])
  @@index([userId])
  @@index([applicationId])
  @@index([predictionType])
  @@index([timestamp])
  @@index([isCorrect])
  @@map("predictions")
}

model PredictionFeedback {
  id           String   @id @default(cuid())
  predictionId String   @map("prediction_id")
  userId       String   @map("user_id") @db.Uuid
  rating       Int?
  helpful      Boolean?
  correct      Boolean?
  comment      String?  @db.Text
  feedbackType String   @map("feedback_type")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  prediction Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([predictionId])
  @@index([userId])
  @@map("prediction_feedback")
}

