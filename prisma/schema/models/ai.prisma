enum AiExtractionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  REQUIRES_REVIEW
}

model Model {
  id                 String   @id
  name               String
  version            String
  provider           String
  capabilities       String[]
  isActive           Boolean  @default(true) @map("is_active")
  contextWindow      Int?     @map("context_window")
  maxOutputTokens    Int?     @map("max_output_tokens")
  costPer1kInput     Float?   @map("cost_per_1k_input")
  costPer1kOutput    Float?   @map("cost_per_1k_output")
  supportsJsonMode   Boolean  @default(true) @map("supports_json_mode")
  supportsStreaming   Boolean  @default(true) @map("supports_streaming")
  defaultTemperature Float    @default(0.1) @map("default_temperature")
  metadata           Json     @default("{}") @map("metadata")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  predictions      Prediction[]
  extractionRuns   ExtractionRun[]

  @@map("models")
}

model Prediction {
  id                String   @id @default(cuid())
  modelId           String   @map("model_id")
  userId            String   @map("user_id") @db.Uuid
  recruiterId       String?  @map("recruiter_id") @db.Uuid
  applicationId     String?  @map("application_id") @db.Uuid
  opportunityId     String?  @map("opportunity_id") @db.Uuid
  extractionRunId   String?  @map("extraction_run_id") @db.Uuid
  predictionType    String   @map("prediction_type")
  capability        String?
  predictionValue   Json     @map("prediction_value")
  confidenceScore   Float    @map("confidence_score")
  confidenceBand    String?  @map("confidence_band")
  provider          String?
  latencyMs         Int?     @map("latency_ms")
  inputTokens       Int?     @map("input_tokens")
  outputTokens      Int?     @map("output_tokens")
  estimatedCostUsd  Float?   @map("estimated_cost_usd")
  rawOutput         Json?    @map("raw_output")
  outputValid       Boolean? @map("output_valid")
  outputErrors      Json     @default("[]") @map("output_errors")
  requiresReview    Boolean  @default(false) @map("requires_review")
  reviewReason      String?  @map("review_reason") @db.Text
  plannerContext    Json     @default("{}") @map("planner_context")
  timestamp         DateTime @default(now()) @db.Timestamptz
  isCorrect         Boolean? @map("is_correct")
  evaluationNote    String?  @map("evaluation_note") @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  model         Model                @relation(fields: [modelId], references: [id], onDelete: Cascade)
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   JobApplication?      @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  opportunity   Opportunity?         @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  extractionRun ExtractionRun?       @relation(fields: [extractionRunId], references: [id], onDelete: SetNull)
  feedback      PredictionFeedback[]

  @@index([modelId])
  @@index([userId])
  @@index([recruiterId])
  @@index([applicationId])
  @@index([predictionType])
  @@index([capability])
  @@index([provider])
  @@index([timestamp])
  @@index([isCorrect])
  @@index([requiresReview])
  @@index([outputValid])
  @@map("predictions")
}

model PredictionFeedback {
  id                  String    @id @default(cuid())
  predictionId        String    @map("prediction_id")
  userId              String    @map("user_id") @db.Uuid
  rating              Int?
  helpful             Boolean?
  correct             Boolean?
  comment             String?   @db.Text
  feedbackType        String    @map("feedback_type")
  expectedValue       Json?     @map("expected_value")
  actualValue         Json?     @map("actual_value")
  confidenceAtPred    Float?    @map("confidence_at_pred")
  outcomeOccurredAt   DateTime? @map("outcome_occurred_at") @db.Timestamptz
  calibrationBucket   String?   @map("calibration_bucket")
  metadata            Json      @default("{}") @map("metadata")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  prediction Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([predictionId])
  @@index([userId])
  @@index([calibrationBucket])
  @@map("prediction_feedback")
}

model ExtractionRun {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  cellId           String?  @map("cell_id")
  sourceType       String   @map("source_type")
  sourceId         String   @map("source_id") @db.Uuid
  sourceVersion    String?  @map("source_version")
  sourceIdentity   String?  @map("source_identity")
  modelId          String   @map("model_id")
  modelVersion     String?  @map("model_version")
  status           String   @default("pending")
  startedAt        DateTime? @map("started_at") @db.Timestamptz
  completedAt      DateTime? @map("completed_at") @db.Timestamptz
  error            String?   @db.Text
  failureReason    String?   @map("failure_reason") @db.Text
  metadata         Json     @default("{}")
  parserVersion    String?   @map("parser_version")
  modelProvider    String?   @map("model_provider")
  promptVersion    String?   @map("prompt_version")
  schemaVersion    String?   @map("schema_version")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  email            EmailMessage?   @relation(fields: [sourceId], references: [id], map: "extraction_email_fk", onDelete: Cascade)
  resume           Resume?         @relation(fields: [sourceId], references: [id], map: "extraction_resume_fk", onDelete: Cascade)
  opportunity      Opportunity?    @relation(fields: [sourceId], references: [id], map: "extraction_opportunity_fk", onDelete: Cascade)
  application      JobApplication? @relation(fields: [sourceId], references: [id], map: "extraction_application_fk", onDelete: Cascade)
  model            Model           @relation(fields: [modelId], references: [id])
  predictions      Prediction[]
  facts            FactObservation[]
  provenance       FactProvenance?

  @@index([userId])
  @@index([sourceType, sourceId])
  @@map("extraction_runs")
}

model FactProvenance {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  cellId           String?  @map("cell_id")
  sourceType       String   @map("source_type")
  sourceId         String   @map("source_id")
  sourceVersion    String?  @map("source_version")
  sourceIdentity   String?  @map("source_identity")
  extractionRunId  String   @unique @map("extraction_run_id") @db.Uuid
  parserVersion    String?  @map("parser_version")
  modelProvider    String?  @map("model_provider")
  modelVersion     String?  @map("model_version")
  promptVersion    String?  @map("prompt_version")
  schemaVersion    String   @map("schema_version")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  extractionRun    ExtractionRun   @relation(fields: [extractionRunId], references: [id], onDelete: Cascade)
  facts            FactObservation[]
  canonicalLinks   CanonicalCandidateIntelligence[]

  @@index([userId])
  @@map("fact_provenance")
}

model MalwareScanResult {
  id             String    @id @default(uuid()) @db.Uuid
  userResumeId   String    @map("user_resume_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  scanner        String
  result         String
  threats        Json?
  scanDurationMs Int?      @map("scan_duration_ms")
  scannedAt      DateTime  @default(now()) @map("scanned_at") @db.Timestamptz
  metadata       Json      @default("{}")

  @@index([userResumeId])
  @@index([userId])
  @@map("malware_scan_results")
}

model AiPromptTemplate {
  id               String   @id @default(uuid()) @db.Uuid
  templateId       String   @unique @map("template_id")
  name             String
  version          String
  tier             String
  systemPrompt     String   @map("system_prompt") @db.Text
  userPromptTpl    String   @map("user_prompt_tpl") @db.Text
  outputSchema     Json     @map("output_schema")
  maxTokens        Int      @map("max_tokens")
  temperature      Float    @default(0.1)
  deprecated       Boolean  @default(false)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  extractionRuns   AiExtractionRun[]

  @@index([templateId])
  @@index([deprecated])
  @@map("ai_prompt_templates")
}

model AiExtractionRun {
  id                String              @id @default(uuid()) @db.Uuid
  extractionId      String              @unique @map("extraction_id")
  tenantId          String              @map("tenant_id") @db.Uuid
  templateId        String              @map("template_id")
  templateVersion   String              @map("template_version")
  sourceType        String              @map("source_type")
  sourceId          String              @map("source_id")
  provider          String
  model             String
  status            AiExtractionStatus  @default(PENDING)
  inputTokens       Int                 @default(0) @map("input_tokens")
  outputTokens      Int                 @default(0) @map("output_tokens")
  estimatedCostUsd  Float               @default(0) @map("estimated_cost_usd")
  latencyMs         Int                 @default(0) @map("latency_ms")
  overallConfidence Float               @default(0) @map("overall_confidence")
  requiresReview    Boolean             @default(false) @map("requires_review")
  reviewReason      String?             @map("review_reason") @db.Text
  error             String?             @db.Text
  provenanceJson    Json                @default("{}") @map("provenance_json")
  requestedAt       DateTime            @map("requested_at") @db.Timestamptz
  completedAt       DateTime?           @map("completed_at") @db.Timestamptz
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  promptTemplate    AiPromptTemplate?   @relation(fields: [templateId], references: [templateId])
  results           AiExtractionResult[]
  modelUsage        AiModelUsage[]

  @@index([tenantId])
  @@index([templateId])
  @@index([status])
  @@index([sourceType, sourceId])
  @@index([requestedAt])
  @@map("ai_extraction_runs")
}

model AiExtractionResult {
  id               String   @id @default(uuid()) @db.Uuid
  extractionRunId  String   @map("extraction_run_id") @db.Uuid
  fieldName        String   @map("field_name")
  rawValue         String   @map("raw_value") @db.Text
  normalizedValue  String?  @map("normalized_value") @db.Text
  structuredValue  Json     @map("structured_value")
  confidence       Float    @default(0.5)
  confidenceBand   String   @map("confidence_band")
  evidenceJson     Json     @default("[]") @map("evidence_json")
  provenanceJson   Json     @default("{}") @map("provenance_json")
  requiresReview   Boolean  @default(false) @map("requires_review")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  extractionRun    AiExtractionRun @relation(fields: [extractionRunId], references: [id], onDelete: Cascade)

  @@index([extractionRunId])
  @@index([fieldName])
  @@index([confidence])
  @@map("ai_extraction_results")
}

model AiModelUsage {
  id               String   @id @default(uuid()) @db.Uuid
  usageId          String   @unique @map("usage_id")
  extractionRunId  String?  @map("extraction_run_id") @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  provider         String
  model            String
  templateId       String   @map("template_id")
  inputTokens      Int      @map("input_tokens")
  outputTokens     Int      @map("output_tokens")
  totalTokens      Int      @map("total_tokens")
  estimatedCostUsd Float    @map("estimated_cost_usd")
  latencyMs        Int      @map("latency_ms")
  success          Boolean  @default(true)
  error            String?  @db.Text
  recordedAt       DateTime @map("recorded_at") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  extractionRun    AiExtractionRun? @relation(fields: [extractionRunId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([provider, model])
  @@index([templateId])
  @@index([recordedAt])
  @@index([success])
  @@map("ai_model_usage")
}

model AiHumanReviewQueue {
  id              String   @id @default(uuid()) @db.Uuid
  reviewId        String   @unique @map("review_id")
  extractionId    String   @map("extraction_id")
  tenantId        String   @map("tenant_id") @db.Uuid
  reason          String   @db.Text
  flaggedFields   Json     @default("[]") @map("flagged_fields")
  extractedData   Json     @default("{}") @map("extracted_data")
  confidence      Float    @default(0.5)
  status          String   @default("pending")
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz
  reviewedBy      String?  @map("reviewed_by") @db.Uuid
  reviewNotes     String?  @map("review_notes") @db.Text
  queuedAt        DateTime @map("queued_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([extractionId])
  @@index([tenantId])
  @@index([status])
  @@index([queuedAt])
  @@map("ai_human_review_queue")
}
