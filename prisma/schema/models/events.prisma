model OutcomeEvent {
  id               String   @id @default(uuid()) @db.Uuid
  applicationId    String   @map("application_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  outcomeType      String   @map("outcome_type")
  outcomeCategory  String   @map("outcome_category")
  outcomeStatus    String   @map("outcome_status")
  explicit         Boolean
  sourceType       String   @map("source_type")
  sourceId         String?  @map("source_id")
  sourceData       Json?    @map("source_data")
  evidence         String?
  confidence       Float
  occurredAt       DateTime @map("occurred_at") @db.Timestamptz
  recordedAt       DateTime @default(now()) @map("recorded_at") @db.Timestamptz
  resultingStatus  String?  @map("resulting_status")
  version          Int      @default(1)
  supersededById   String?  @map("superseded_by_id") @db.Uuid
  isCurrent        Boolean  @default(true) @map("is_current")
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  application      JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([userId])
  @@index([occurredAt])
  @@index([outcomeType])
  @@index([userId, outcomeType, occurredAt])
  @@map("outcome_events")
}

model ActionEvent {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  applicationId    String?  @map("application_id") @db.Uuid
  opportunityId    String?  @map("opportunity_id") @db.Uuid
  actionType       String   @map("action_type")
  actionSubtype    String?  @map("action_subtype")
  strategyTags     String[] @default([]) @map("strategy_tags")
  context          Json?
  sourceType       String   @default("USER_ACTION") @map("source_type")
  sourceId         String?  @map("source_id")
  occurredAt       DateTime @map("occurred_at") @db.Timestamptz
  recordedAt       DateTime @default(now()) @map("recorded_at") @db.Timestamptz
  notes            String?
  confidence       Float?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  application      JobApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  opportunity      Opportunity?    @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, actionType])
  @@index([userId, occurredAt])
  @@index([applicationId])
  @@index([opportunityId])
  @@index([actionType])
  @@index([occurredAt])
  @@map("action_events")
}

model Event {
  id            String    @id @default(uuid()) @db.Uuid
  eventType     String    @map("event_type")
  aggregateId   String    @map("aggregate_id")
  aggregateType String    @map("aggregate_type")
  userId        String    @map("user_id") @db.Uuid
  cellId        String    @map("cell_id")
  payload       Json
  status        String    @default("pending")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  processedAt   DateTime? @map("processed_at") @db.Timestamptz
  retryCount    Int       @default(0) @map("retry_count")
  correlationId String    @map("correlation_id")
  error         String?   @db.Text
  leaseOwner    String?   @map("lease_owner")
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([status, createdAt])
  @@index([aggregateId, aggregateType])
  @@index([status])
  @@index([correlationId])
  @@index([leaseOwner, leaseExpiresAt])
  @@map("events")
}
