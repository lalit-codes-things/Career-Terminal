  technicalFocusJson    Json     @map("technical_focus_json")
  industryFocusJson     Json     @map("industry_focus_json")
  organizationCtxJson   Json     @map("organization_ctx_json")
  communicationStyle    String   @map("communication_style") @db.Text
  recruitingStyle       String   @map("recruiting_style") @db.Text
  velocitySignalsJson   Json     @map("velocity_signals_json")
  relationshipJson      Json     @map("relationship_json")
  candidateFitJson      Json     @map("candidate_fit_json")
  evidenceRefsJson      Json     @default("[]") @map("evidence_refs_json")
  overallConfidence     Float    @default(0.5) @map("overall_confidence")
  factCount             Int      @default(0) @map("fact_count")
  inferenceCount        Int      @default(0) @map("inference_count")
  version               Int      @default(1)
  generatedAt           DateTime @map("generated_at") @db.Timestamptz
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([recruiterId])
