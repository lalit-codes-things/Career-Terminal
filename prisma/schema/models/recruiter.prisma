model RecruiterIntelligenceProfile {
  id                    String   @id @default(uuid()) @db.Uuid
  profileId             String   @unique @map("profile_id")
  recruiterId           String   @map("recruiter_id") @db.Uuid
  summaryText           String   @map("summary_text") @db.Text
  summaryConfidence     Float    @map("summary_confidence")
